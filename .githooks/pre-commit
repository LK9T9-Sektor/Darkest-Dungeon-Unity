#!/bin/sh
# Pre-commit hook: reject commits whose scenes/prefabs reference script GUIDs that do not
# resolve to a committed .meta (the stale-GUID failure mode). Install via tools\install-hooks.ps1
# (git config core.hooksPath .githooks).

ROOT=$(git rev-parse --show-toplevel)

pwsh -NoProfile -File "$ROOT/tools/check-script-references.ps1" -ProjectPath unity || exit 1
pwsh -NoProfile -File "$ROOT/tools/check-script-references.ps1" -ProjectPath unity-2017 || exit 1

exit 0
