<views:PumpableScreenBase x:Class="Sektor.DarkestDungeon.Wpf.Views.DuelBattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Width="1920" Height="1080">
    <UserControl.Resources>
        <!-- Duel unit card: enemy-tinted body, target/current highlight frames -->
        <DataTemplate x:Key="DuelUnitTemplate">
            <Grid Width="185" Height="250">
                <Border Width="150" Height="150" CornerRadius="8" Margin="0,10,0,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#5A4A3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                    <Setter Property="Background" Value="#6A2E24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0,4,8"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>

                <!-- Current turn frame -->
                <Border Width="158" Height="158" BorderThickness="3" CornerRadius="10" Margin="0,6,0,0"
                        VerticalAlignment="Top" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="White" />

                <!-- Valid target frame -->
                <Border Width="166" Height="166" BorderThickness="3" CornerRadius="12" Margin="0,2,0,0"
                        VerticalAlignment="Top" Visibility="{Binding IsTarget, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="#D9B46A" />

                <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" />

                <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpRatio, Mode=OneWay}" Height="12"
                             HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="14,196,14,0" />
                <TextBlock Text="{Binding HpText}" Foreground="#B0A080" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,210,0,0" />
                <TextBlock Text="{Binding Stress, StringFormat=Stress {0}}" Foreground="#777" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,226,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Clickable duel slot -->
        <DataTemplate x:Key="DuelSlotTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding DataContext.TargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DuelUnitTemplate}" />
                        </Button>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#100C08">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR: status, turn order strip, retreat -->
        <Grid Grid.Row="0" Background="{StaticResource AreaBackground}">
            <TextBlock Text="{Binding Status}" FontSize="20" Foreground="#D9B46A"
                       HorizontalAlignment="Left" VerticalAlignment="Center" Margin="32,0,0,0" />

            <ItemsControl ItemsSource="{Binding TurnOrder}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border MinWidth="150" Margin="6,0" Padding="10,5" CornerRadius="14" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2A221A" />
                                    <Setter Property="BorderBrush" Value="#554433" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                            <Setter Property="Background" Value="#33190F" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E8D9B0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Name}" FontSize="14" Foreground="#CBB98F" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Retreat" Width="120" Height="36" FontSize="15"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,32,0"
                    Style="{StaticResource HudButton}"
                    Command="{Binding LeaveCommand}" />
        </Grid>

        <!-- BATTLE FIELD: local party left ranks, rival party right ranks, facing each other -->
        <Grid Grid.Row="1">
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,28,24,16"
                    Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource FieldBorder}"
                    BorderThickness="2" CornerRadius="12" />

            <ItemsControl ItemsSource="{Binding Heroes}" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="70,0,0,40">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DuelSlotTemplate}"
                                        Margin="8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Monsters}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,70,40">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DuelSlotTemplate}"
                                        Margin="8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- BOTTOM BAR: skills of the acting unit + battle log -->
        <Grid Grid.Row="2" Margin="24,0,24,20">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="Skills" FontSize="16" Foreground="#8A7A5A" Margin="0,8,0,4" />
                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}" Width="220" Height="40" Margin="4"
                                    FontSize="15"
                                    IsEnabled="{Binding IsUsable}"
                                    Command="{Binding DataContext.SelectSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#E8D9B0" />
                                                <Setter Property="Background" Value="#3A3022" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Width="480" Height="170" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="#14100C" BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="8" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="13" Foreground="#9A8A6A" Margin="0,1" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</views:PumpableScreenBase>
