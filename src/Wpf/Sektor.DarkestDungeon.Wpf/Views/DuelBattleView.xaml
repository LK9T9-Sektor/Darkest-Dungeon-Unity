<views:PumpableScreenBase x:Class="Sektor.DarkestDungeon.Wpf.Views.DuelBattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             Width="1920" Height="1080">
    <views:PumpableScreenBase.Resources>
        <!-- Duel unit card: enemy-tinted body, target/current highlight frames -->
        <DataTemplate x:Key="DuelUnitTemplate">
            <Grid Width="185" Height="250">
                <Border Width="150" Height="150" CornerRadius="8" Margin="0,10,0,0" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#5A4A3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                    <Setter Property="Background" Value="#6A2E24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="4,0,4,8"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>

                <!-- Current turn frame -->
                <Border Width="158" Height="158" BorderThickness="3" CornerRadius="10" Margin="0,6,0,0"
                        VerticalAlignment="Top" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="White" />

                <!-- Valid target frame -->
                <Border Width="166" Height="166" BorderThickness="3" CornerRadius="12" Margin="0,2,0,0"
                        VerticalAlignment="Top" Visibility="{Binding IsTarget, Converter={StaticResource BoolToVisibility}}"
                        BorderBrush="#D9B46A" />

                <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="15" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,170,0,0" />

                <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpRatio, Mode=OneWay}" Height="12"
                             HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="14,196,14,0" />
                <TextBlock Text="{Binding HpText}" Foreground="#B0A080" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,210,0,0" />
                <TextBlock Text="{Binding Stress, StringFormat=Stress {0}}" Foreground="#777" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,226,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Clickable duel slot: left-click targets, hover/right-click show info -->
        <DataTemplate x:Key="DuelSlotTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Template>
                    <ControlTemplate TargetType="ContentControl">
                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                Command="{Binding DataContext.TargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseEnter">
                                    <i:InvokeCommandAction Command="{Binding DataContext.HoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseLeave">
                                    <i:InvokeCommandAction Command="{Binding DataContext.UnhoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="MouseRightButtonDown">
                                    <i:InvokeCommandAction Command="{Binding DataContext.OpenStatsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource DuelUnitTemplate}" />
                        </Button>
                    </ControlTemplate>
                </ContentControl.Template>
            </ContentControl>
        </DataTemplate>
    </views:PumpableScreenBase.Resources>

    <Grid Background="#100C08">
        <Grid.RowDefinitions>
            <RowDefinition Height="170" />
            <RowDefinition Height="*" />
            <RowDefinition Height="360" />
        </Grid.RowDefinitions>

        <!-- TOP AREA: quest + retreat (left), torch (center), turn order (right) -->
        <Grid Grid.Row="0" Background="{StaticResource AreaBackground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0">
                <views:QuestLogView DataContext="{Binding Quest}" Width="360" />
                <Button Content="X" Width="34" Height="34" FontSize="18" FontWeight="Bold"
                        Foreground="#C0392B" Margin="0,8,0,0" Style="{StaticResource HudButton}"
                        ToolTip="Retreat"
                        Command="{Binding LeaveCommand}" />
            </StackPanel>

            <views:TorchView Grid.Column="1" DataContext="{Binding Torch}"
                             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />

            <views:TurnOrderView Grid.Column="2" DataContext="{Binding}"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
        </Grid>

        <!-- CENTER AREA: battle field, round overlay, stats sheet, log -->
        <Grid Grid.Row="1">
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,28,24,16"
                    Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource FieldBorder}"
                    BorderThickness="2" CornerRadius="12" />

            <views:EventsLayerView DataContext="{Binding Events}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <ItemsControl ItemsSource="{Binding Heroes}" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Margin="70,0,0,60">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DuelSlotTemplate}"
                                        Margin="8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding Monsters}" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,70,60">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DuelSlotTemplate}"
                                        Margin="8,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Stats sheet, opened by right-clicking a unit -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="560" Height="330" Margin="60,40,0,0"
                  Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource OverlayPanel}">
                    <Grid Margin="{StaticResource SpacingMedium}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0" Content="X" Command="{Binding CloseStatsCommand}"
                                HorizontalAlignment="Right" Width="30" Height="30"
                                Style="{StaticResource HudButton}" FontWeight="Bold" />
                        <views:HeroStatsView Grid.Row="1" DataContext="{Binding StatsTarget}" Margin="0,8,0,0" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM AREA: acting hero skills, then raid HUD (actor info / tooltip / log, inventory, map) -->
        <Grid Grid.Row="2" Margin="24,8,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Skills" FontSize="16" Foreground="#8A7A5A"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <ItemsControl ItemsSource="{Binding Skills}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayName}" Width="150" Height="32" Margin="4"
                                    FontSize="14"
                                    IsEnabled="{Binding IsUsable}"
                                    Command="{Binding DataContext.SelectSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="#E8D9B0" />
                                                <Setter Property="Background" Value="#3A3022" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="MOVE" Width="80" Height="32" Margin="12,4,0,4" FontSize="14"
                        Style="{StaticResource HudButton}" Command="{Binding MoveCommand}" />
                <Button Content="PASS" Width="80" Height="32" Margin="4,4,0,4" FontSize="14"
                        Style="{StaticResource HudButton}" Command="{Binding PassCommand}" />
            </StackPanel>

            <views:RaidHudView Grid.Row="1" DataContext="{Binding}" />
        </Grid>
    </Grid>
</views:PumpableScreenBase>