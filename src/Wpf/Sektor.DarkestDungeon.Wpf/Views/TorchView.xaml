<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.TorchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reworked torch panel: top row = left/right arrows hugging a flame glyph tinted by the torch
         level; below = the round number in its own circle with big yellow text. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="{StaticResource SpacingSmall}">
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
            <!-- Top row: arrows pinned to the top, flame glyph centered -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="&#9664;" Style="{StaticResource HudButton}"
                        Command="{Binding DecreaseCommand}" Width="44" Height="34" FontSize="18" />
                <Path Width="30" Height="34" Stretch="Uniform" Margin="6,0"
                      Fill="{Binding TorchLevelBrush}"
                      Data="M12,1 C14,5 22,7 22,16 C22,22 17,25 12,27 C7,25 2,22 2,16 C2,7 10,5 12,1 Z">
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFB040" Opacity="0.85" />
                    </Path.Effect>
                </Path>
                <Button Content="&#9654;" Style="{StaticResource HudButton}"
                        Command="{Binding IncreaseCommand}" Width="44" Height="34" FontSize="18" />
            </StackPanel>

            <!-- Round number in a circle, big yellow text; below it the acting unit's name in its team color -->
            <Border Width="44" Height="44" CornerRadius="22" Margin="0,6,0,0"
                    Background="#C0000000" BorderBrush="#3A2E22" BorderThickness="2"
                    HorizontalAlignment="Center" ToolTip="Round">
                <TextBlock Text="{Binding Round}" Foreground="#E8D9B0" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="{Binding ActorName}" Foreground="{Binding ActorColor}" FontSize="14"
                       FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,6,0,0"
                       ToolTip="Acting now" />
        </StackPanel>
    </Border>
</UserControl>