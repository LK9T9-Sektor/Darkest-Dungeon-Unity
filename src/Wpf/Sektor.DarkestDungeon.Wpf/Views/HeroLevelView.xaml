<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroLevelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <!-- Reusable hero level medallion: a rounded black frame around a centered circular badge with
         the level number. The host supplies only the level. -->
    <Border Width="58" Height="58" Background="#E6000000" BorderBrush="#3A2E22" BorderThickness="2"
            CornerRadius="14" ToolTip="Hero level">
        <Grid>
            <Ellipse Width="40" Height="40" Fill="#1A150F" Stroke="#D9B46A" StrokeThickness="2" />
            <TextBlock Text="{Binding Level, ElementName=Root}" Foreground="#F0C070" FontSize="20"
                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
