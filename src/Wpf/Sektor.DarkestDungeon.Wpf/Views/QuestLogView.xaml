<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.QuestLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Style="{StaticResource OverlayPanel}">
        <Grid Margin="{StaticResource SpacingSmall}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="20"
                       FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="1" Text="{Binding Goal}" Foreground="#C8C0B0" FontSize="16"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
        </Grid>
    </Border>
</UserControl>