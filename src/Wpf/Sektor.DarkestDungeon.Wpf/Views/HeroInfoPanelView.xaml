<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroInfoPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <!-- Darkest-Dungeon style hero stat sheet: stats in one bordered control (no portrait/name/class
         here — those live in the acting-hero strip above), equipment and trinket controls. -->
    <Border Style="{StaticResource OverlayPanel}">
        <StackPanel VerticalAlignment="Top" Margin="{StaticResource SpacingTight}">
            <!-- Stats in one bordered control, two columns -->
            <Border BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="4" Padding="6,4">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,8,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HP" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.HitPoints}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stress" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Stress}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,8,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ACC" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Accuracy}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CRIT" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Crit}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,8,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DMG" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Damage}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DODGE" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Dodge}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,8,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PROT" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Protection}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                        <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SPD" Foreground="#C8C0B0" FontSize="12" />
                            <TextBlock Grid.Column="1" Text="{Binding Hero.Stats.Speed}"
                                       Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Equipment + trinkets side by side -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:HeroEquipmentView Grid.Column="0" DataContext="{Binding Hero.Stats}" Margin="0,0,3,0" />
                <views:HeroTrinketsView Grid.Column="1" DataContext="{Binding Hero.Stats}" Margin="3,0,0,0" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>