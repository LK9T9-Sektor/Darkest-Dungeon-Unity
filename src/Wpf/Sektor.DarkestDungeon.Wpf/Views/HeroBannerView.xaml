<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Portrait + name/class, pinned to the top -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,4,0,0">
            <Border Width="60" Height="60" Background="#5A4A3A" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="6">
                <TextBlock Text="?" Foreground="#E8D9B0" FontSize="28"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding Name}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="18" FontWeight="Bold" />
                <TextBlock Text="{Binding ClassName}" Foreground="#C8C0B0" FontSize="14" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
