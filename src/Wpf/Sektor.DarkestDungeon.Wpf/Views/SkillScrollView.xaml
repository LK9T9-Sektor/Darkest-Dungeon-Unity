<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SkillScrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <!-- Reusable skill grid with a bounded number of visible rows. The inner AbilityRowView is the
         single source of skill-square chrome; this control only adds the row cap and the vertical
         scroller. An empty list keeps one row of height, and ReservedSlots reserves width for a
         fixed number of tiles without adding placeholder items. -->
    <ScrollViewer x:Name="Scroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  Focusable="False">
        <views:AbilityRowView ItemsSource="{Binding ItemsSource, ElementName=Root}"
                              SelectCommand="{Binding SelectCommand, ElementName=Root}"
                              IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                              IconSize="{Binding IconSize, ElementName=Root}"
                              ShowNames="{Binding ShowNames, ElementName=Root}"
                              ShowLevels="{Binding ShowLevels, ElementName=Root}" />
    </ScrollViewer>
</UserControl>
