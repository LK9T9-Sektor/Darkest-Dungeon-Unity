<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleSceneBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <Border Style="{StaticResource OverlayPanel}" Padding="14,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <views:InfoCellView Label="СЦЕНА"
                                    Value="{Binding Scene, ElementName=Root}"
                                    Margin="0,0,24,0" />
                <views:InfoCellView Label="КОМНАТА"
                                    Value="{Binding Room, ElementName=Root}"
                                    Detail="{Binding RoomType, ElementName=Root}"
                                    Margin="0,0,20,0" />
                <views:InfoCellView Label="РАУНД"
                                    Value="{Binding Round, ElementName=Root}"
                                    Margin="0,0,16,0" />
                <views:InfoCellView Label="ХОД"
                                    Value="{Binding Turn, ElementName=Root}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <views:TorchInfoView Value="{Binding Torch, ElementName=Root}"
                                     Margin="0,0,24,0" />
                <views:InfoCellView Label="ЗОЛОТО"
                                    Value="{Binding Gold, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
