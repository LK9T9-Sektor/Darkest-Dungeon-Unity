<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SkillTooltipView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Structured skill tooltip: a level badge + centered name on top, a separator, the base info
         (damage/heal, accuracy, crit, ranks) and, when the skill applies buffs/debuffs, an aligned
         table of those effects below. -->
    <Border Background="#E6000000" BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="6" Padding="12,10">
        <StackPanel>
            <!-- HEADER: level badge (left), centered name (the right spacer mirrors the badge) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="24" Background="#3A3022" BorderBrush="#6A5A3A" BorderThickness="1"
                        CornerRadius="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Level}" Foreground="#E8D9B0" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="#E8D9B0" FontSize="16"
                           FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="8,0" />
                <Border Grid.Column="2" Width="26" />
            </Grid>

            <!-- SEPARATOR -->
            <Border Height="1" Background="#3A2E22" Margin="0,8,0,8" />

            <!-- BASE INFO -->
            <TextBlock Text="{Binding BaseInfo}" Foreground="#C8C0B0" FontSize="13" TextWrapping="Wrap"
                       LineHeight="17" />

            <!-- EFFECT TABLE: what the skill applies, tone-colored -->
            <ItemsControl ItemsSource="{Binding EffectRows}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13" FontWeight="Bold"
                                       Margin="0,0,12,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9ACA9A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tone}" Value="Debuff">
                                                <Setter Property="Foreground" Value="#CA9A9A" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13"
                                       Foreground="#C8C0B0" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>