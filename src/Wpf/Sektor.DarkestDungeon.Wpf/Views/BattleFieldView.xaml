<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleFieldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <UserControl.Resources>
        <!-- One slot: click selects the target, right-click opens the unit sheet, hover drives the
             screen-owned overlay. The commands are optional, so the same field renders an
             interactive battle and a passive replay. -->
        <DataTemplate x:Key="UnitTemplate">
            <Button Background="Transparent" BorderThickness="0" Padding="0" Margin="8,0"
                    Command="{Binding SelectCommand, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                    CommandParameter="{Binding}"
                    MouseEnter="OnSlotMouseEnter" MouseLeave="OnSlotMouseLeave"
                    MouseRightButtonDown="OnSlotRightButtonDown">
                <views:BattleUnitCardView Width="{Binding CardWidth}" Height="330"
                                          Rank="{Binding Rank}"
                                          Hp="{Binding Hp}"
                                          MaxHp="{Binding MaxHp}"
                                          Stress="{Binding Stress}"
                                          MaxStress="{Binding MaxStress}"
                                          ContentDirectory="{Binding ContentDirectory}"
                                          Loop="{Binding Loop}"
                                          Skeleton="{Binding Skeleton}"
                                          IsEnemy="{Binding IsEnemy}"
                                          IsMirrored="{Binding IsEnemy}"
                                          IsAttacker="{Binding IsAttacker}"
                                          IsTarget="{Binding IsTarget}"
                                          IsDead="{Binding IsDead}"
                                          ActivityLabel="{Binding ActivityLabel, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                                          ActivityTone="{Binding ActivityTone, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                                          InfoCommand="{Binding InfoCommand, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                                          AnimationCompletedCommand="{Binding AnimationCompletedCommand, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}" />
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="24,16,24,12"
                Background="{StaticResource FieldBackground}" BorderBrush="{StaticResource FieldBorder}"
                BorderThickness="2" CornerRadius="12" />

        <!-- Battle stage: unit cards keep their natural proportions (no flattening) and hug the
             bottom edge with a small offset -->
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                 Margin="24,0,24,12" ClipToBounds="True">
            <Grid x:Name="Stage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="820" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition MinWidth="820" />
                </Grid.ColumnDefinitions>

                <ItemsControl Grid.Row="1" Grid.Column="0"
                              ItemsSource="{Binding LeftUnits, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                              ItemTemplate="{StaticResource UnitTemplate}"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <ItemsControl Grid.Row="1" Grid.Column="2"
                              ItemsSource="{Binding RightUnits, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}"
                              ItemTemplate="{StaticResource UnitTemplate}"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Screen-owned layer stretched over the stage (target arrows in a live battle) -->
                <ContentPresenter Grid.RowSpan="2" Grid.ColumnSpan="3" Panel.ZIndex="10"
                                  Content="{Binding Overlay, RelativeSource={RelativeSource AncestorType=views:BattleFieldView}}" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
