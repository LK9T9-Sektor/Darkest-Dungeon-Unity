<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.PartySelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <Border Style="{StaticResource OverlayPanel}" Padding="{StaticResource SpacingMedium}">
        <Grid>
            <StackPanel>
                <!-- Player label, top-left -->
                <TextBlock Text="{Binding PlayerLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#E8D9B0" FontSize="22" FontWeight="Bold" Margin="2,0,0,10" />
                <views:HeroSlotsPanel Slots="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SlotEditRequested="OnSlotEditRequested" />
            </StackPanel>

            <!-- Modal hero loadout editor, covering the whole party panel. -->
            <Grid x:Name="EditorHost" Visibility="Collapsed" Focusable="True"
                  PreviewKeyDown="OnEditorPreviewKeyDown">
                <Border Background="#B0000000" MouseLeftButtonUp="OnEditorBackdropClick" />
                <views:HeroEditorOverlayView x:Name="Editor" CloseRequested="OnEditorCloseRequested" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
