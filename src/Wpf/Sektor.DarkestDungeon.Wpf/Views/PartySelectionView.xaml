<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.PartySelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <Border Style="{StaticResource OverlayPanel}" Padding="{StaticResource SpacingMedium}">
        <StackPanel>
            <!-- Player label, top-left -->
            <TextBlock Text="{Binding PlayerLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#E8D9B0" FontSize="22" FontWeight="Bold" Margin="2,0,0,10" />
            <views:HeroSlotsPanel Slots="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </Border>
</UserControl>