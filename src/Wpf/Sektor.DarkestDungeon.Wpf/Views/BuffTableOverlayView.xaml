<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BuffTableOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Buff/debuff table row: Name | Duration | Effect, effect text toned by Buff/Debuff -->
        <DataTemplate x:Key="BuffRowTemplate">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.6*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#E8D9B0" FontSize="14"
                           TextWrapping="Wrap" Margin="2,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding DurationText}" Foreground="#C8C0B0" FontSize="14"
                           TextAlignment="Right" Margin="2,0,8,0" />
                <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="14" TextWrapping="Wrap"
                           Margin="2,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#9ACA9A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Debuff">
                                    <Setter Property="Foreground" Value="#CA9A9A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Width="900" Height="520"
            Background="#FF0C0A08" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="8">
        <Grid Margin="{StaticResource SpacingMedium}"
              DataContext="{Binding Target, ElementName=Root}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <views:HeroPortraitView Grid.Column="0"
                                        Portrait="{Binding Portrait}"
                                        PortraitSize="56"
                                        ShowArrows="False"
                                        VerticalAlignment="Top"
                                        Margin="0,0,12,0" />
                <views:UnitHeaderView Grid.Column="1"
                                      Rank="{Binding Rank}"
                                      DisplayName="{Binding Name}"
                                      ClassName="{Binding ClassName}"
                                      IsEnemy="{Binding IsEnemy}"
                                      CloseCommand="{Binding CloseCommand, ElementName=Root}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Section headers -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="BUFFS"
                               Foreground="#E8D9B0" FontSize="15" FontWeight="Bold" Margin="2,0,0,4" />
                    <TextBlock Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="3" Text="DEBUFFS"
                               Foreground="#E8D9B0" FontSize="15" FontWeight="Bold" Margin="2,0,0,4" />

                    <!-- Column sub-headers -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Name" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="Duration" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Effect" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Name" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="4" Text="Duration" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,8,2" />
                    <TextBlock Grid.Row="1" Grid.Column="5" Text="Effect" Foreground="#8A7A5A" FontSize="13"
                               FontWeight="Bold" Margin="2,0,0,2" />

                    <ItemsControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding Buffs}"
                                  ItemTemplate="{StaticResource BuffRowTemplate}" />
                    <ItemsControl Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="3"
                                  ItemsSource="{Binding Debuffs}"
                                  ItemTemplate="{StaticResource BuffRowTemplate}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
