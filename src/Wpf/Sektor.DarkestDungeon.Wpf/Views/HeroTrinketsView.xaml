<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroTrinketsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Read-only two-slot trinket panel used by the battle hero sheet. The lobby uses the editable
         TrinketSlotView/HeroTrinketsEditorView instead. -->
    <Border Style="{StaticResource SectionPanel}">
        <StackPanel>
        <TextBlock Text="TRINKETS" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                   Margin="0,0,0,4" />
        <UniformGrid Columns="2">
            <Border Width="72" Height="144" Background="#1A150F" BorderBrush="#3A2E22"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,4,0">
                <TextBlock Text="{Binding Trinket1Text}" Foreground="#E8D9B0" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" />
            </Border>
            <Border Width="72" Height="144" Background="#1A150F" BorderBrush="#3A2E22"
                    BorderThickness="1" CornerRadius="4" Margin="4,0,0,0">
                <TextBlock Text="{Binding Trinket2Text}" Foreground="#E8D9B0" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6" />
            </Border>
        </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
