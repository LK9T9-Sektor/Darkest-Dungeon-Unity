<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.TorchInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="ФАКЕЛ"
                   Style="{StaticResource PanelCaption}"
                   VerticalAlignment="Center" />
        <ProgressBar Minimum="0" Maximum="100"
                     Value="{Binding Value, ElementName=Root}"
                     Width="160" Height="10" Margin="10,0" />
        <TextBlock Text="{Binding Value, ElementName=Root}"
                   Style="{StaticResource PanelValue}" />
    </StackPanel>
</UserControl>
