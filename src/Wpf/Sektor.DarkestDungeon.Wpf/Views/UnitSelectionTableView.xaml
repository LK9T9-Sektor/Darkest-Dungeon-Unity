<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.UnitSelectionTableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Table">
    <Border Background="#14100C" BorderBrush="#2A2218" BorderThickness="1"
            CornerRadius="4" Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Margin="4,0,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Slots" Style="{StaticResource PanelCaption}" />
                <TextBlock Grid.Column="1" Text="Icon" Style="{StaticResource PanelCaption}"
                           HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Class" Style="{StaticResource PanelCaption}" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rows, ElementName=Table}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" BorderThickness="0,0,0,1"
                                    MouseLeftButtonDown="OnRowMouseLeftButtonDown">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="#2A2218" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelectable}" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#2A2218" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Size}"
                                               Foreground="#D9B46A" FontSize="15" FontWeight="Bold"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="4,0,0,0" />
                                    <Border Grid.Column="1" Width="40" Height="40" Background="#2A2218"
                                            BorderBrush="#3A2E22" BorderThickness="1"
                                            CornerRadius="4" HorizontalAlignment="Center">
                                        <Image Source="{Binding Icon}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}"
                                               Foreground="#E8D9B0" FontSize="15"
                                               VerticalAlignment="Center" Margin="4,0,8,0"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
