<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SinglePlayerLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Width="1100" Height="560"
             Background="#1E1E1E"
             TextElement.Foreground="White">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: title + hero slots -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="VS AI — PICK YOUR PARTY" FontSize="20" Margin="0,0,0,12" Foreground="#E8D9B0" />
            <views:HeroSlotsPanel Slots="{Binding Slots}" />
        </StackPanel>

        <!-- RIGHT: rival + actions -->
        <StackPanel Grid.Column="1" Margin="32,0,0,0">
            <TextBlock Text="{Binding RivalSummary}" TextWrapping="Wrap" Margin="0,42,0,0" Foreground="#D9B46A" />
            <Button Content="Reroll AI Party" Width="180" Height="34" Margin="0,10,0,0"
                    HorizontalAlignment="Left" Command="{Binding RandomizeRivalCommand}" />

            <Button Content="Start Battle" Width="180" Height="44" Margin="0,26,0,0"
                    HorizontalAlignment="Left" FontSize="16" Command="{Binding StartCommand}" />
            <Button Content="Back" Width="100" Height="30" Margin="0,14,0,0"
                    HorizontalAlignment="Left" Command="{Binding BackCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
