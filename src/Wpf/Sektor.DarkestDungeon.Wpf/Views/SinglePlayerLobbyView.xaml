<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SinglePlayerLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Background="#14100C"
             TextElement.Foreground="White">
    <Grid Margin="40,24,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + close (back) -->
        <views:ScreenHeaderView Grid.Row="0"
                                Title="СФОРМИРУЙТЕ ОТРЯД"
                                CloseCommand="{Binding BackCommand}" />

        <!-- Parties side by side -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:PartySelectionView Grid.Column="0" PlayerLabel="#1 Player" Slots="{Binding Slots}"
                                      IsReversedSlots="True"
                                      ShowClassArrows="False"
                                      SlotEditRequested="OnSlotEditRequested" Margin="0,0,12,0" />
            <views:PartySelectionView Grid.Column="1" PlayerLabel="#2 AI" Slots="{Binding AiSlots}"
                                      IsReversedSlots="False"
                                      IsMirrored="True"
                                      ShowClassArrows="False"
                                      SlotEditRequested="OnSlotEditRequested" Margin="12,0,0,0" />
        </Grid>

        <!-- Unit selection table: select a slot above, then double-click a row -->
        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource OverlayPanel}"
                Padding="{StaticResource SpacingSmall}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding SelectionStatus}" Foreground="#C8C0B0"
                           FontSize="13" Margin="2,0,0,6" />

                <TabControl Grid.Row="1" Height="210" Background="#14100C"
                            BorderBrush="#3A2E22" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Foreground" Value="#C8C0B0" />
                            <Setter Property="FontSize" Value="15" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Chrome" Background="#202020"
                                                BorderBrush="#3A2E22" BorderThickness="1"
                                                Padding="18,6" Margin="0,0,4,0">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#3A2A18" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D9B46A" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E8D9B0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Heroes">
                        <views:UnitSelectionTableView Rows="{Binding HeroRows}"
                                                      ActivateCommand="{Binding ActivateRowCommand}" />
                    </TabItem>
                    <TabItem Header="Monsters">
                        <views:UnitSelectionTableView Rows="{Binding MonsterRows}"
                                                      ActivateCommand="{Binding ActivateRowCommand}" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Reroll AI" Width="180" Height="44" FontSize="16"
                    Style="{StaticResource HudButton}" Margin="0,0,16,0"
                    Command="{Binding RandomizeRivalCommand}" />
            <Button Content="Start Battle" Width="260" Height="48" FontSize="18"
                    Style="{StaticResource HudButton}" Command="{Binding StartCommand}" />
        </StackPanel>

        <views:LobbyHeroEditorHost x:Name="HeroEditor" Grid.RowSpan="4" />
    </Grid>
</UserControl>
