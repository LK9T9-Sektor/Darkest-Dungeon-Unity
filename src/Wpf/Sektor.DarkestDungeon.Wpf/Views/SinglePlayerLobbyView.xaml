<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SinglePlayerLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Width="1920" Height="1080"
             Background="#14100C"
             TextElement.Foreground="White">
    <Grid Margin="64,48,64,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + close cross -->
        <views:ScreenHeaderView Grid.Row="0"
                                Title="VS AI &#x2014; PICK YOUR PARTY"
                                CloseCommand="{Binding BackCommand}" />

        <!-- Row 1: player's four hero slots -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
            <views:HeroSlotsPanel Slots="{Binding Slots}" />
        </StackPanel>

        <!-- Row 2: AI party selection -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Text="{Binding RivalSummary}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#D9B46A" FontSize="20" MaxWidth="900" />
            <Button Content="Reroll AI Party" Width="220" Height="38" Margin="0,14,0,0"
                    HorizontalAlignment="Center" FontSize="16"
                    Style="{StaticResource HudButton}" Command="{Binding RandomizeRivalCommand}" />
        </StackPanel>

        <!-- Row 3 (bottom): start battle -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8">
            <Button Content="Start Battle" Width="260" Height="48" FontSize="18"
                    Style="{StaticResource HudButton}" Command="{Binding StartCommand}" />
        </StackPanel>
    </Grid>
</UserControl>