<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroPortraitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="HeroCard">
    <!-- Reusable hero card: roster portrait in the dark DD frame with the hero name under it and
         optional class-cycling arrows around the portrait. Portrait/Caption/PortraitSize, the arrow
         commands and the portrait click command are dependency properties, so any screen can host the
         card: Spine Test shows the arrows, the battle HUD can hide them. Without a SelectCommand the
         portrait is read-only. -->
    <StackPanel VerticalAlignment="Center">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Previous class -->
            <Button x:Name="PreviousButton" Grid.Column="0" Content="&#x25C0;"
                    Width="{Binding ArrowSize, ElementName=HeroCard}"
                    Height="{Binding ArrowSize, ElementName=HeroCard}"
                    FontSize="12" Margin="0,0,4,0"
                    VerticalAlignment="Center" Focusable="False"
                    Style="{StaticResource HudButton}"
                    AutomationProperties.Name="Previous hero"
                    ToolTip="Previous hero"
                    Command="{Binding PreviousCommand, ElementName=HeroCard}"
                    Visibility="{Binding ShowArrows, ElementName=HeroCard, Converter={StaticResource BoolToVisibility}}" />

            <Button x:Name="PortraitButton" Grid.Column="1"
                    Command="{Binding SelectCommand, ElementName=HeroCard}"
                    Focusable="False" Cursor="Arrow" IsHitTestVisible="False"
                    AutomationProperties.Name="Hero portrait"
                    Background="Transparent" BorderThickness="0" Padding="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>

                <Border x:Name="PortraitFrame"
                        Width="{Binding PortraitSize, ElementName=HeroCard}"
                        Height="{Binding PortraitSize, ElementName=HeroCard}"
                        Background="#5A4A3A" BorderBrush="#3A2E22" BorderThickness="1"
                        CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Image Source="{Binding Portrait, ElementName=HeroCard}" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="?" Foreground="#E8D9B0" FontSize="36"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Portrait, ElementName=HeroCard}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Button>

            <!-- Next class -->
            <Button x:Name="NextButton" Grid.Column="2" Content="&#x25B6;"
                    Width="{Binding ArrowSize, ElementName=HeroCard}"
                    Height="{Binding ArrowSize, ElementName=HeroCard}"
                    FontSize="12" Margin="4,0,0,0"
                    VerticalAlignment="Center" Focusable="False"
                    Style="{StaticResource HudButton}"
                    AutomationProperties.Name="Next hero"
                    ToolTip="Next hero"
                    Command="{Binding NextCommand, ElementName=HeroCard}"
                    Visibility="{Binding ShowArrows, ElementName=HeroCard, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <TextBlock Text="{Binding Caption, ElementName=HeroCard}" Foreground="#E8D9B0"
                   FontSize="13" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"
                   MaxWidth="{Binding PortraitSize, ElementName=HeroCard}" Margin="0,6,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Caption, ElementName=HeroCard}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
