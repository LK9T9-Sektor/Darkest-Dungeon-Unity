<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroEquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Equipment control: weapon and armor slots side by side, each a reusable EquipmentSlotView
         with a centered glyph, a plain level number and a 72x144 image placeholder. -->
    <Border Style="{StaticResource SectionPanel}" Padding="6,4">
        <StackPanel>
            <views:SectionHeaderView Text="EQUIPMENT" />
            <UniformGrid Columns="2">
                <views:EquipmentSlotView Glyph="&#x2694;" Level="{Binding WeaponLevel}"
                                         Tooltip="Weapon" Margin="1,0" HorizontalAlignment="Center" />
                <views:EquipmentSlotView Glyph="&#x26E8;" Level="{Binding ArmorLevel}"
                                         Tooltip="Armor" Margin="1,0" HorizontalAlignment="Center" />
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>
