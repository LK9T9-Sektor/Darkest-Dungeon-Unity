<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroEquipmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Equipment control: row 1 = crossed-swords glyph + weapon level, shield glyph + armor level;
         row 2 = elongated rectangles reserved for future weapon/armor images. -->
    <Border Style="{StaticResource OverlayPanel}" Padding="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#x2694;" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#E8D9B0"
                           VerticalAlignment="Center" ToolTip="Weapon" />
                <TextBlock Grid.Column="1" Text="{Binding WeaponLevel}" Foreground="#C8C0B0" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,14,0" />

                <Path Grid.Column="2" Width="18" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                      Fill="#E8D9B0" ToolTip="Armor"
                      Data="M9,0 L17,3 L17,11 C17,17 13,21 9,23 C5,21 1,17 1,11 L1,3 Z" />
                <TextBlock Grid.Column="3" Text="{Binding ArmorLevel}" Foreground="#C8C0B0" FontSize="12"
                           VerticalAlignment="Center" Margin="6,0,0,0" />
            </Grid>

            <!-- Weapon/armor image slots (future art), elongated rectangles -->
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="26" Margin="0,0,3,0" Background="#2A2218"
                        BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="3" VerticalAlignment="Bottom" />
                <Border Grid.Column="1" Height="26" Margin="3,0,0,0" Background="#2A2218"
                        BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="3" VerticalAlignment="Bottom" />
            </Grid>
        </Grid>
    </Border>
</UserControl>