<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroEditorOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Wide pre-battle hero sheet, modelled on the Darkest Dungeon guild banner: close flush in the
         top-right corner, reroll/name/class on the left, the bordered class-card with the formation
         position on the right. The body is a four-column table: standing Idle hero, quirks/base stats
         across the middle columns, equipment/trinkets below them, and skills/camping/resistances/
         diseases in the right column. -->
    <Border x:Name="EditorPanel" Style="{StaticResource OverlayPanel}" Margin="12" MaxWidth="1240" MaxHeight="760"
            Background="#E6000000" Padding="0" VerticalAlignment="Center" ClipToBounds="True">
        <Grid>
            <!-- Guild header art: top-left background, never the cycling element. -->
            <Image Source="{Binding Header}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                   MaxWidth="700" MaxHeight="700" Opacity="0.55" IsHitTestVisible="False" />
            <Border Background="#55000000" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: reroll-name on the left, name/class stacked, bordered portrait group on the
                     right. The close button lives outside the header grid so it sits flush in the
                     overlay corner. -->
                <Border Grid.Row="0" BorderBrush="#3A2E22" BorderThickness="0,0,0,2" Padding="10,4,0,4">
                    <Grid Margin="0,0,46,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <views:HeroIdentityView Grid.Column="0" VerticalAlignment="Center"
                                                HeroName="{Binding HeroName}"
                                                ClassName="{Binding Stats.HeroClass}"
                                                IsEditing="{Binding IsEditingName}"
                                                MaxNameLength="{Binding MaxHeroNameLength}"
                                                EditCommand="{Binding EditNameCommand}"
                                                RerollCommand="{Binding RerollNameCommand}" />
                    </Grid>
                </Border>

                <!-- Flush close control: square against the overlay's top-right corner. -->
                <Button x:Name="CloseButton" Grid.Row="0" Content="&#x2715;" Width="36" Height="36"
                        FontSize="15" Style="{StaticResource CloseButton}" ToolTip="Close"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0"
                        Panel.ZIndex="10"
                        AutomationProperties.Name="Close hero editor"
                        Click="OnCloseClick" />

                <!-- Table-like body. The ScrollViewer keeps the minimum-size window usable; at the
                     default window height the table fits without a scrollbar. -->
                <ScrollViewer x:Name="BodyScroller" Grid.Row="1" Margin="12,8,12,10"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <Grid x:Name="BodyGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="190" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- COLUMN 1: level, Idle above the bottom controls, then portrait/skin/class. -->
                        <Grid Grid.Column="0" Grid.RowSpan="4" Margin="0,0,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <views:HeroLevelView x:Name="HeroLevel" Grid.Row="0" Level="{Binding Level}"
                                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Margin="0,0,0,8" />

                            <views:SpineHeroControl x:Name="IdleHero" Grid.Row="1"
                                                    ContentDirectory="{Binding IdleContentDirectory}"
                                                    Loop="True" BottomInset="16"
                                                    Height="360" VerticalAlignment="Bottom"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="0,0,0,8"
                                                    Visibility="{Binding IdleContentDirectory, Converter={StaticResource StringToVisibility}}" />
                            <Border x:Name="IdleFallback" Grid.Row="1" Height="360" VerticalAlignment="Bottom"
                                    Background="#221A150F" BorderBrush="#3A2E22" BorderThickness="1"
                                    CornerRadius="6" Padding="8" Margin="0,0,0,8"
                                    Visibility="{Binding IdleContentDirectory, Converter={StaticResource StringToVisibility}, ConverterParameter=Invert}">
                                <Image Source="{Binding Portrait}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <views:HeroCharacterControlsView x:Name="CharacterControls" Grid.Row="2"
                                                             Margin="0,4,0,0"
                                                             Portrait="{Binding Portrait}"
                                                             Position="{Binding Position}"
                                                             SkinId="{Binding SkinId}"
                                                             PreviousCommand="{Binding PrevClassCommand}"
                                                             NextCommand="{Binding NextClassCommand}"
                                                             SelectSkinCommand="{Binding NextSkinCommand}" />
                        </Grid>

                        <!-- QUIRKS: spans the middle two columns; five visible rows, then scroll. -->
                        <Border Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,4,6"
                                VerticalAlignment="Top" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="QUIRKS" />
                                <views:BoundedScrollView DefaultRows="5" MaxRows="5" RowHeight="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl Grid.Column="0" Margin="0,0,8,0"
                                                  ItemsSource="{Binding PositiveQuirks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding LockIcon}"
                                                           Width="14" Height="14"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                               Foreground="#9ACA9A" FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding NegativeQuirks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Grid.Column="0" Source="{Binding LockIcon}"
                                                           Width="14" Height="14"
                                                           HorizontalAlignment="Left" VerticalAlignment="Top"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                               Foreground="#CA9A9A" FontSize="12"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                </views:BoundedScrollView>
                            </StackPanel>
                        </Border>

                        <!-- BASE STATS: spans the middle two columns; four visible rows, then scroll. -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,4,6"
                                VerticalAlignment="Top" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="BASE STATS" />
                                <views:BoundedScrollView DefaultRows="4" MaxRows="4" RowHeight="28">
                                    <views:HeroStatsView DataContext="{Binding Stats}" ShowHeader="False"
                                                         ShowFullDetails="False" ShowEquipment="False" />
                                </views:BoundedScrollView>
                            </StackPanel>
                        </Border>

                        <!-- EQUIPMENT: bottom-left middle column. -->
                        <views:HeroEquipmentView x:Name="EquipmentSection" Grid.Row="3" Grid.Column="1"
                                                 Margin="0,0,4,0" VerticalAlignment="Bottom"
                                                 DataContext="{Binding Stats}" />

                        <!-- TRINKETS: bottom-right middle column. -->
                        <views:HeroTrinketsEditorView x:Name="TrinketsSection" Grid.Row="3" Grid.Column="2"
                                                      Margin="0,0,4,0" VerticalAlignment="Bottom"
                                                      ItemsSource="{Binding TrinketSlots}" />

                        <!-- COLUMN 4: skills, camping skills, resistances, diseases. -->
                        <Border Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="SKILLS" />
                                <views:SkillScrollView x:Name="SkillsScroller"
                                                       ItemsSource="{Binding Skills}"
                                                       SelectCommand="{Binding ToggleSkillCommand}"
                                                       IconSize="48" ShowNames="False" ShowLevels="True"
                                                       MaxRows="1" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="CAMPING SKILLS" />
                                <views:SkillScrollView x:Name="CampingScroller"
                                                       ItemsSource="{Binding CampingSkills}"
                                                       SelectCommand="{Binding ToggleCampingSkillCommand}"
                                                       IconSize="48" ShowNames="False" ShowLevels="False"
                                                       MaxRows="1" />
                            </StackPanel>
                        </Border>

                        <!-- Bottom-right stack: resistances directly above the fixed disease row. -->
                        <StackPanel Grid.Row="3" Grid.Column="3" VerticalAlignment="Bottom">
                        <Border Margin="0,0,0,6" Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="RESISTANCES" />
                                <views:BoundedScrollView DefaultRows="4" MaxRows="4" RowHeight="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Stun" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistStun, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Blight" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistBlight, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Bleed" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistBleed, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Debuff" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDebuff, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Move" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistMove, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Disease" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDisease, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,10,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Death Blow" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDeathBlow, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                    <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Trap" Foreground="#C8C0B0" FontSize="12" />
                                        <TextBlock Grid.Column="1" Text="{Binding Stats.ResistTrap, StringFormat={}{0}%}"
                                                   Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                                    </Grid>
                                </Grid>
                                </views:BoundedScrollView>
                            </StackPanel>
                        </Border>

                        <!-- DISEASES: plain rows in one column, like quirks/stats; empty rows stay reserved. -->
                        <Border Style="{StaticResource SectionPanel}">
                            <StackPanel>
                                <views:SectionHeaderView Text="DISEASES" />
                                <views:BoundedScrollView DefaultRows="3" MaxRows="3" RowHeight="20">
                                    <ItemsControl x:Name="DiseasesList" ItemsSource="{Binding Diseases}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#CA9A9A"
                                                               FontSize="12" TextAlignment="Left"
                                                               TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </views:BoundedScrollView>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
