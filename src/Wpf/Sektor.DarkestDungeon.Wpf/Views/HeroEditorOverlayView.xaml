<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroEditorOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Wide pre-battle hero sheet, modelled on the battle acting-hero strip: position/name/class/close
         on top, hero icon with arrows, stats and equipment on the left, abilities/quirks/resistances on
         the right. The guild header art is a background from the top-left. -->
    <Border Style="{StaticResource OverlayPanel}" Margin="24" MaxWidth="1120" MaxHeight="700"
            Background="#E6000000" Padding="0" VerticalAlignment="Stretch">
        <Grid>
            <!-- Guild header art: top-left background, never the cycling element. -->
            <Image Source="{Binding Header}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"
                   MaxWidth="700" MaxHeight="700" Opacity="0.55" IsHitTestVisible="False" />
            <Border Background="#55000000" IsHitTestVisible="False" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header: position, hero icon with class arrows, name/class, close -->
                <Grid Grid.Row="0" Margin="18,14,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="38" Height="38" Background="#3A2A18"
                            BorderBrush="#D98A3A" BorderThickness="2" CornerRadius="4"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Position, StringFormat=#{0}}" Foreground="#F0C070"
                                   FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <views:HeroPortraitView Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                            Portrait="{Binding Portrait}" Caption=""
                                            PortraitSize="64" ArrowSize="24" ShowArrows="True"
                                            PreviousCommand="{Binding PrevClassCommand}"
                                            NextCommand="{Binding NextClassCommand}" />

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding HeroName}" Foreground="#E8D9B0" FontSize="22"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                            <Button Content="&#x21BB;" Width="22" Height="22" Margin="8,0,0,0" FontSize="12"
                                    Style="{StaticResource HudButton}" ToolTip="Reroll name"
                                    Command="{Binding RerollNameCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding Stats.HeroClass}" Foreground="#C8C0B0" FontSize="13" />
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="3" Content="&#x2715;" Width="36" Height="36"
                            FontSize="16" Style="{StaticResource HudButton}" ToolTip="Close"
                            Background="#C0392B" Foreground="#FFFFFF" BorderBrush="#E05A4A"
                            AutomationProperties.Name="Close hero editor"
                            Click="OnCloseClick" />
                </Grid>

                <!-- Table-like body: left stats/equipment/trinkets, center reserved, right abilities/quirks/resistances. -->
                <Grid Grid.Row="1" Margin="18,0,18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: stats, weapon/armor, trinkets -->
                    <StackPanel Grid.Column="0">
                        <views:HeroStatsView DataContext="{Binding Stats}" ShowHeader="False"
                                             ShowFullDetails="False" ShowEquipment="False" />
                        <views:HeroEquipmentView DataContext="{Binding Stats}" Margin="0,8,0,0" />
                        <views:HeroTrinketsEditorView ItemsSource="{Binding TrinketSlots}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- CENTER: reserved for later content; the guild art shows through. -->
                    <Border Grid.Column="1" Margin="18,0" BorderBrush="#33D9B46A" BorderThickness="1,0" />

                    <!-- RIGHT: abilities, quirks, resistances -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SKILLS" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <views:AbilityRowView ItemsSource="{Binding Skills}"
                                              SelectCommand="{Binding ToggleSkillCommand}"
                                              IconSize="56"
                                              ShowNames="False" />
                        <TextBlock Text="skills locked" FontSize="11" Foreground="#C8A060"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SkillsLocked, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="QUIRKS" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                                   Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="POSITIVE" Foreground="#9ACA9A" FontSize="10" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding PositiveQuirks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}" Foreground="#9ACA9A" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="NEGATIVE" Foreground="#CA9A9A" FontSize="10" FontWeight="Bold" />
                                <ItemsControl ItemsSource="{Binding NegativeQuirks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Id}" Foreground="#CA9A9A" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="RESISTANCES" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                                   Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,10,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stun" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistStun, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Blight" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistBlight, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,10,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bleed" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistBleed, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Debuff" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDebuff, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,10,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Move" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistMove, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Disease" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDisease, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,10,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Death Blow" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistDeathBlow, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Trap" Foreground="#C8C0B0" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="{Binding Stats.ResistTrap, StringFormat={}{0}%}"
                                           Foreground="#E8D9B0" FontSize="12" TextAlignment="Right" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
