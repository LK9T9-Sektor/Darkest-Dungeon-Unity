<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroEditorOverlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Modal hero loadout editor shown by HeroSlotsPanel: guild header art, class-cycling arrows,
         stats, active-skill selection, quirks and trinkets. Changes apply immediately to the slot. -->
    <Border Style="{StaticResource OverlayPanel}" Margin="24" MaxWidth="840" MaxHeight="660"
            Background="#E6000000" Padding="0" VerticalAlignment="Stretch">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: hero name/class and close button -->
            <Grid Grid.Row="0" Margin="16,12,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="HERO LOADOUT" Foreground="#8A7A5A" FontSize="12" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;" Width="36" Height="36"
                        FontSize="16" Style="{StaticResource HudButton}" ToolTip="Close"
                        AutomationProperties.Name="Close hero editor"
                        Click="OnCloseClick" />
            </Grid>

            <!-- Guild header art on the left; stats, skills, quirks and trinkets on the right. -->
            <Grid Grid.Row="1" Margin="16,8,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <views:HeroPortraitView Grid.Column="0" VerticalAlignment="Top"
                                        Portrait="{Binding Header}"
                                        Caption="{Binding ClassName}"
                                        PortraitSize="140"
                                        ArrowSize="36"
                                        ShowArrows="True"
                                        PreviousCommand="{Binding PrevClassCommand}"
                                        NextCommand="{Binding NextClassCommand}" />

                <ScrollViewer Grid.Column="1" Margin="16,0,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <views:HeroStatsView DataContext="{Binding Stats}" ShowHeader="False"
                                             ShowFullDetails="False" />

                        <TextBlock Text="SKILLS" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                                   Margin="0,12,0,4" />
                        <views:AbilityRowView ItemsSource="{Binding Skills}"
                                              SelectCommand="{Binding ToggleSkillCommand}"
                                              IconSize="48"
                                              ShowNames="False" />
                        <TextBlock Text="skills locked" FontSize="11" Foreground="#C8A060"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding SkillsLocked, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Quirks + reroll -->
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding QuirkSummary}" FontSize="11" Foreground="#C8C0B0"
                                       TextWrapping="Wrap" ToolTip="{Binding QuirkSummary}" />
                            <Button Grid.Column="1" Content="&#x21BB;" Width="26" Height="26" Margin="6,0,0,0"
                                    FontSize="12" Style="{StaticResource HudButton}" ToolTip="Reroll quirks"
                                    Command="{Binding RerollQuirksCommand}" />
                        </Grid>

                        <!-- Trinket slots (2) + reroll -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Trinkets" FontSize="11" Foreground="#8A7A5A" />
                            <ItemsControl ItemsSource="{Binding TrinketSlots}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="&#x25C0;" Width="22" Height="22" FontSize="10"
                                                    Style="{StaticResource HudButton}" ToolTip="Previous trinket"
                                                    Command="{Binding PrevCommand}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10"
                                                       Foreground="#E8D9B0" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"
                                                       Margin="4,0" />
                                            <Button Grid.Column="2" Content="&#x25B6;" Width="22" Height="22"
                                                    FontSize="10" Style="{StaticResource HudButton}"
                                                    ToolTip="Next trinket" Command="{Binding NextCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="&#x21BB; Trinkets" Height="24" FontSize="11" Margin="0,4,0,0"
                                    HorizontalAlignment="Left" Style="{StaticResource HudButton}"
                                    ToolTip="Assign random trinkets" Command="{Binding RerollTrinketsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
