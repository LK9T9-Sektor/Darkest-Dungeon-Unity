<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.PveLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Background="#14100C"
             TextElement.Foreground="White">
    <Grid Margin="40,24,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + close (back) -->
        <views:ScreenHeaderView Grid.Row="0"
                                Title="PvE — СОБЕРИТЕ ОТРЯД"
                                CloseCommand="{Binding BackCommand}" />

        <!-- Parties side by side -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:PartySelectionView Grid.Column="0" PlayerLabel="#1 Heroes" Slots="{Binding Slots}"
                                      Margin="0,0,12,0" />

            <!-- Monster side: a compact picker cycling monster classes -->
            <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource OverlayPanel}"
                    Padding="{StaticResource SpacingMedium}">
                <StackPanel>
                    <TextBlock Text="#2 Monsters" Foreground="#E8D9B0" FontSize="22" FontWeight="Bold"
                               Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding MonsterSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource OverlayPanel}" Padding="10" Margin="6"
                                        BorderBrush="#3A2E22" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <Button Content="&#x25B2;" Width="30" Height="24" FontSize="12"
                                                Style="{StaticResource HudButton}" HorizontalAlignment="Center"
                                                ToolTip="Previous monster" Command="{Binding PrevCommand}" />
                                        <TextBlock Text="{Binding DisplayName}" Foreground="#E8D9B0" FontSize="13"
                                                   FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                                                   TextWrapping="Wrap" MaxWidth="160" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding SizeLabel}" Foreground="#D9B46A" FontSize="11"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                        <Button Content="&#x25BC;" Width="30" Height="24" FontSize="12"
                                                Style="{StaticResource HudButton}" HorizontalAlignment="Center"
                                                ToolTip="Next monster" Command="{Binding NextCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock FontSize="13" Margin="2,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#8A7A5A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MonsterSideFits}" Value="False">
                                        <Setter Property="Foreground" Value="#C0392B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Total size {0} / 4">
                                <Binding Path="MonsterTotalSize" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <TextBlock Text="Seed" Foreground="#C8C0B0" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0" />
            <Button Content="&#x25C0;" Width="40" Height="40" FontSize="14" Style="{StaticResource HudButton}"
                    Margin="0,0,4,0" Command="{Binding DecreaseSeedCommand}" />
            <TextBlock Text="{Binding Seed}" FontSize="18" FontWeight="Bold" Foreground="#E8D9B0"
                       VerticalAlignment="Center" Width="70" TextAlignment="Center" />
            <Button Content="&#x25B6;" Width="40" Height="40" FontSize="14" Style="{StaticResource HudButton}"
                    Margin="4,0,24,0" Command="{Binding IncreaseSeedCommand}" />
            <Button Content="Start Battle" Width="260" Height="48" FontSize="18"
                    Style="{StaticResource HudButton}" Command="{Binding StartCommand}"
                    IsEnabled="{Binding CanStart}" />
        </StackPanel>
    </Grid>
</UserControl>