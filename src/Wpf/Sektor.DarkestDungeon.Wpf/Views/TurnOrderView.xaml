<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.TurnOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Stretch">
        <StackPanel Margin="{StaticResource SpacingSmall}">
            <!-- Title pinned to the right edge -->
            <TextBlock Text="TURN ORDER" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="16"
                       FontWeight="Bold" HorizontalAlignment="Right" />

            <!-- One row, reading right-to-left like the in-game turn order -->
            <ItemsControl ItemsSource="{Binding TurnOrder}" FlowDirection="RightToLeft" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="70" Height="72" CornerRadius="6" Margin="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#2A2220" />
                                    <Setter Property="BorderBrush" Value="#8A2E2E" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E4A8A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="White" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Margin="4" VerticalAlignment="Center">
                                <!-- Image slot (empty until a portrait is provided) -->
                                <Image Source="{Binding Portrait}" Width="30" Height="30"
                                       HorizontalAlignment="Center" Stretch="UniformToFill" />
                                <TextBlock Text="{Binding Name}" FontSize="11" HorizontalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="60" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#C96A5A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                                <Setter Property="Foreground" Value="#6A8AC9" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Speed}" FontSize="10" Foreground="#8A7A5A" />
                                    <TextBlock Text="{Binding InitiativeRoll, StringFormat=  &#x2192;  {0:0.0}}"
                                               FontSize="10" Foreground="#C8B088" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>