<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.TurnOrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Style="{StaticResource OverlayPanel}" HorizontalAlignment="Stretch">
        <StackPanel Margin="{StaticResource SpacingSmall}">
            <!-- Title pinned to the right edge -->
            <TextBlock Text="TURN ORDER" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="16"
                       FontWeight="Bold" HorizontalAlignment="Right" />

            <!-- One row, reading right-to-left like the in-game turn order. The strip shows the whole
                 round sequence captured at the round start, so tiles never collapse or jump; the
                 acting unit keeps its white frame for the whole turn and dead units just dim in place. -->
            <ItemsControl ItemsSource="{Binding TurnOrder}" FlowDirection="RightToLeft" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="72" Height="96" CornerRadius="6" Margin="4" Background="#2A2220">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#8A2E2E" />
                                    <Setter Property="BorderThickness" Value="2" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                            <Setter Property="BorderBrush" Value="#2E4A8A" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter Property="BorderBrush" Value="White" />
                                            <Setter Property="BorderThickness" Value="3" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDead}" Value="True">
                                            <Setter Property="Opacity" Value="0.35" />
                                            <Setter Property="BorderBrush" Value="#555555" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Name on top -->
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           MaxWidth="66" Margin="2,3,2,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#C96A5A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                                    <Setter Property="Foreground" Value="#6A8AC9" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Bordered slot reserved for the future character icon -->
                                <Border Grid.Row="1" Margin="3,4,3,4" BorderBrush="#3A2E22"
                                        BorderThickness="1" CornerRadius="3" />

                                <!-- Bottom values flush to the edges: real speed bottom-left, the
                                     rolled initiative (speed + roll) bottom-right -->
                                <Grid Grid.Row="2" Margin="3,0,3,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Speed}" FontSize="11"
                                               FontWeight="Bold" Foreground="#8A7A5A"
                                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                               ToolTip="Speed" />
                                    <TextBlock Grid.Column="1" Text="{Binding InitiativeRoll, StringFormat={}{0:0.0}}"
                                               FontSize="11" FontWeight="Bold" Foreground="#C8B088"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               ToolTip="Round initiative" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>