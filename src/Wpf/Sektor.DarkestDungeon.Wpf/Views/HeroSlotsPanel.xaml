<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Compact party row: four slots. A left click selects a slot for the lobby table;
         right-clicking a hero slot raises SlotEditRequested. Slots are displayed back rank
         (4) to front rank (1), while the underlying collection keeps pick order 1..4. -->
    <ItemsControl x:Name="SlotsItems">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Padding="6" Margin="6"
                        ToolTip="Click to select; right-click to edit hero"
                        MouseLeftButtonUp="OnSlotClick"
                        MouseRightButtonUp="OnSlotRightClick">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource OverlayPanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="BorderBrush" Value="#D9B46A" />
                                    <Setter Property="BorderThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Position}"
                                   FontSize="11" FontWeight="Bold" Foreground="#E8D9B0"
                                   HorizontalAlignment="Left" Margin="2,0,0,4"
                                   ToolTip="Position" />
                        <StackPanel Grid.Row="1">
                            <views:HeroPortraitView Portrait="{Binding UnitPortrait}"
                                                    Caption="{Binding DisplayName}"
                                                    PortraitSize="56"
                                                    SelectCommand="{Binding SelectCommand}"
                                                    ShowArrows="{Binding ShowClassArrows, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    PreviousCommand="{Binding PrevClassCommand}"
                                                    NextCommand="{Binding NextClassCommand}"
                                                    IsMirrored="{Binding IsMirrored, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Text="{Binding UnitClassName}" FontSize="10" Foreground="#C8C0B0"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
