<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Compact party row: four hero icons with class-cycling arrows. Slots are displayed back rank
         (4) to front rank (1), while the underlying collection keeps pick order 1..4. Right-clicking
         a slot raises SlotEditRequested; the hosting PartySelectionView opens the hero loadout editor. -->
    <ItemsControl x:Name="SlotsItems">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource OverlayPanel}" Padding="6" Margin="6"
                        ToolTip="Right-click to edit hero"
                        MouseRightButtonUp="OnSlotRightClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Position}"
                                   FontSize="11" FontWeight="Bold" Foreground="#E8D9B0"
                                   HorizontalAlignment="Left" Margin="2,0,0,4"
                                   ToolTip="Position" />
                        <StackPanel Grid.Row="1">
                            <views:HeroPortraitView Portrait="{Binding Portrait}"
                                                    Caption="{Binding HeroName}"
                                                    PortraitSize="56"
                                                    ArrowSize="24"
                                                    ShowArrows="True"
                                                    PreviousCommand="{Binding PrevClassCommand}"
                                                    NextCommand="{Binding NextClassCommand}" />
                            <TextBlock Text="{Binding ClassName}" FontSize="10" Foreground="#C8C0B0"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
