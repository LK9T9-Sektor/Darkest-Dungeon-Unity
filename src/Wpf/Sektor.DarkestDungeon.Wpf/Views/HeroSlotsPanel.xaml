<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <Button Content="&#x25C0;" Width="28" Command="{Binding PrevClassCommand}" />
                    <TextBlock Text="{Binding ClassName}" Width="180" VerticalAlignment="Center" Margin="8,0"
                               TextElement.Foreground="White" />
                    <Button Content="&#x25B6;" Width="28" Command="{Binding NextClassCommand}" />
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
