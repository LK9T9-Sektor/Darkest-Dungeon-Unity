<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Compact party row: four hero icons with class-cycling arrows. Right-clicking a slot raises
         SlotEditRequested; the hosting PartySelectionView opens the hero loadout editor. -->
    <ItemsControl ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource OverlayPanel}" Padding="6" Margin="6"
                        ToolTip="Right-click to edit hero"
                        MouseRightButtonUp="OnSlotRightClick">
                    <StackPanel>
                        <views:HeroPortraitView Portrait="{Binding Portrait}"
                                                Caption="{Binding HeroName}"
                                                PortraitSize="56"
                                                ArrowSize="24"
                                                ShowArrows="True"
                                                PreviousCommand="{Binding PrevClassCommand}"
                                                NextCommand="{Binding NextClassCommand}" />
                        <TextBlock Text="{Binding ClassName}" FontSize="10" Foreground="#C8C0B0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                        <TextBlock Text="RMB: skills" FontSize="10" Foreground="#8A7A5A"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
