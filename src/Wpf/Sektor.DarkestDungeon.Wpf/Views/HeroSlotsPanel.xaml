<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <ItemsControl ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Style="{StaticResource OverlayPanel}" Padding="10" Margin="6">
                    <StackPanel>
                        <!-- Previous class -->
                        <Button Content="&#x25B2;" Width="30" Height="24" FontSize="12"
                                Style="{StaticResource HudButton}" HorizontalAlignment="Center"
                                ToolTip="Previous class" Command="{Binding PrevClassCommand}" />

                        <!-- Portrait slot -->
                        <Border Width="90" Height="90" Background="#5A4A3A" BorderBrush="#3A2E22" BorderThickness="1"
                                CornerRadius="6" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Grid>
                                <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                                <TextBlock Text="?" Foreground="#E8D9B0" FontSize="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Margin="0,6,0,0" ToolTip="{Binding Details}" />

                        <!-- Next class -->
                        <Button Content="&#x25BC;" Width="30" Height="24" FontSize="12"
                                Style="{StaticResource HudButton}" HorizontalAlignment="Center"
                                ToolTip="Next class" Command="{Binding NextClassCommand}" />

                        <!-- Stats panel (reused from the battle HUD) -->
                        <views:HeroStatsView DataContext="{Binding Stats}" ShowFullDetails="False" Margin="0,8,0,0" />

                        <!-- Active skill toggles, all class skills (no Move/Pass) -->
                        <ItemsControl ItemsSource="{Binding Skills}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Name}" Width="58" Height="26" FontSize="9" Margin="2"
                                            ToolTip="{Binding Details}"
                                            Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                                <Setter Property="Foreground" Value="#777" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#E8D9B0" />
                                                        <Setter Property="BorderBrush" Value="#8A6A3A" />
                                                        <Setter Property="Background" Value="#3A3022" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Quirks + reroll -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{Binding QuirkSummary}" FontSize="10" Foreground="#C8C0B0"
                                       TextWrapping="Wrap" ToolTip="{Binding QuirkSummary}" />
                            <Button Content="&#x21BB;" Width="26" Height="26" Margin="4,0,0,0" FontSize="12"
                                    Style="{StaticResource HudButton}" ToolTip="Reroll quirks"
                                    Command="{Binding RerollQuirksCommand}" />
                        </StackPanel>

                        <!-- Trinket slots (2) + reroll -->
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Trinkets" FontSize="10" Foreground="#8A7A5A" />
                            <ItemsControl ItemsSource="{Binding TrinketSlots}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="&#x25C0;" Width="22" Height="22" FontSize="10"
                                                    Style="{StaticResource HudButton}" ToolTip="Previous trinket"
                                                    Command="{Binding PrevCommand}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="10"
                                                       Foreground="#E8D9B0" HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"
                                                       Margin="4,0" />
                                            <Button Grid.Column="2" Content="&#x25B6;" Width="22" Height="22"
                                                    FontSize="10" Style="{StaticResource HudButton}"
                                                    ToolTip="Next trinket" Command="{Binding NextCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="&#x21BB; Trinkets" Height="24" FontSize="11" Margin="0,4,0,0"
                                    HorizontalAlignment="Center" Style="{StaticResource HudButton}"
                                    ToolTip="Assign random trinkets" Command="{Binding RerollTrinketsCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>