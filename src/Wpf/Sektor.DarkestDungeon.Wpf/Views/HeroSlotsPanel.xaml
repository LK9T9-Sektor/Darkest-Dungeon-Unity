<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroSlotsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ItemsControl ItemsSource="{Binding Slots, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <StackPanel Margin="12,4">
                    <!-- Class cycle -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="&#x25C0;" Width="34" Height="34" FontSize="16"
                                Style="{StaticResource HudButton}" Command="{Binding PrevClassCommand}" />
                        <TextBlock Text="{Binding ClassName}" VerticalAlignment="Center" Margin="8,0"
                                   TextElement.Foreground="White" TextAlignment="Center" FontSize="16"
                                   ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis" />
                        <Button Content="&#x25B6;" Width="34" Height="34" FontSize="16"
                                Style="{StaticResource HudButton}" Command="{Binding NextClassCommand}" />
                    </StackPanel>

                    <!-- Active skill toggles -->
                    <ItemsControl ItemsSource="{Binding Skills}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Width="62" Height="30" FontSize="11" Margin="2"
                                        Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                                            <Setter Property="Foreground" Value="#777" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Foreground" Value="#E8D9B0" />
                                                    <Setter Property="BorderBrush" Value="#8A6A3A" />
                                                    <Setter Property="Background" Value="#3A3022" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Quirks + reroll -->
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="{Binding QuirkSummary}" FontSize="12" Foreground="#C8C0B0"
                                   TextWrapping="Wrap" ToolTip="{Binding QuirkSummary}" />
                        <Button Content="&#x21BB;" Width="30" Height="30" Margin="6,0,0,0" FontSize="14"
                                Style="{StaticResource HudButton}" ToolTip="Reroll quirks"
                                Command="{Binding RerollQuirksCommand}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>