<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroTrinketsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <!-- Reusable two-slot trinket editor with the TRINKETS heading. Each slot rerolls independently. -->
    <Border Style="{StaticResource SectionPanel}" Padding="6,4">
        <StackPanel>
            <views:SectionHeaderView Text="TRINKETS" />
            <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <views:TrinketSlotView Margin="1,0" HorizontalAlignment="Center" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
