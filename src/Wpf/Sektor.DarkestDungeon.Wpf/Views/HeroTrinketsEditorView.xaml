<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroTrinketsEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <!-- Reusable two-slot trinket editor with the TRINKETS heading. Each slot rerolls independently. -->
    <StackPanel>
        <TextBlock Text="TRINKETS" Foreground="#8A7A5A" FontSize="12" FontWeight="Bold"
                   Margin="0,0,0,4" />
        <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=Root}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:TrinketSlotView Margin="2,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
