<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.EstateReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sektor.DarkestDungeon.Wpf.ViewModels"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A7A5A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C0B0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <DataTemplate x:Key="ResourceTemplate" DataType="{x:Type vm:EstateResourceViewModel}">
            <Border Background="#241A12" BorderBrush="#3A2E22" BorderThickness="1"
                    CornerRadius="4" Padding="10,5" Margin="0,0,6,0">
                <TextBlock Text="{Binding Label}" Foreground="#E8D9B0" FontSize="13" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BuildingTemplate" DataType="{x:Type vm:EstateBuildingViewModel}">
            <Border Background="#241A12" BorderBrush="#3A2E22" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,8,8" Width="190">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontWeight="Bold" FontSize="13" />
                    <ProgressBar Height="6" Margin="0,7,0,4" Maximum="100"
                                 Value="{Binding ProgressPercent}" Foreground="#B08A50" Background="#1A120C" />
                    <TextBlock Text="{Binding ProgressText}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HeroTemplate" DataType="{x:Type vm:EstateHeroViewModel}">
            <Border Background="#241A12" BorderBrush="#3A2E22" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontWeight="Bold" FontSize="14" />
                            <TextBlock Text="{Binding Class}" Foreground="#8A7A5A" FontSize="12" Margin="8,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding QuirksText}" Style="{StaticResource BodyText}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DiseasesText}" Foreground="#B07070" FontSize="11"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding LevelText}" Foreground="#E8D9B0" FontSize="12"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding HpText}" Style="{StaticResource BodyText}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding StressText}" Foreground="#E0B0B0" FontSize="12"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding ConditionText}" Foreground="#E0B0B0" FontSize="11"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuestTemplate" DataType="{x:Type vm:EstateQuestViewModel}">
            <Border Background="#241A12" BorderBrush="#3A2E22" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,7">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="#E8D9B0" FontWeight="Bold" FontSize="13" />
                    <TextBlock Text="{Binding Details}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding Goal}" Style="{StaticResource BodyText}" FontSize="11" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate" DataType="{x:Type vm:CaptureTimelineEntryViewModel}">
            <TextBlock Text="{Binding Label}" Padding="4,2" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#8A7A5A" />
                        <Setter Property="FontSize" Value="11" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="#E8D9B0" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter Property="Foreground" Value="#5A4E3E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ScreenHeaderView Grid.Row="0" Margin="48,24,48,0"
                                Title="{Binding ScreenTitle}"
                                CloseCommand="{Binding BackCommand}" />

        <Border Grid.Row="1" Margin="48,16,48,0" Padding="14,10" CornerRadius="8"
                Background="#1A120C" BorderBrush="#3A2E22" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="НЕДЕЛЯ" Foreground="#8A7A5A" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="{Binding Week}" Foreground="#E8D9B0" FontSize="18" FontWeight="Bold"
                               Margin="8,0,20,0" />
                    <TextBlock Text="{Binding CaptureSubtitle}" Foreground="#8A7A5A" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Resources}" Margin="20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ResourceTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2" Text="{Binding TownEventText}" Foreground="#E0B0B0"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="48,16,48,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="ЗДАНИЯ" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Buildings}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="BuildingTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="РОСТЕР" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Roster}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="HeroTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="КВЕСТЫ" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Quests}">
                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="QuestTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ТАЙМЛАЙН" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding Timeline}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="TimelineTemplate" />
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Row="1" Height="150">
                    <TextBlock DockPanel.Dock="Top" Text="АУДИО" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding AudioLog}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="TimelineTemplate" />
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="48,16,48,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="#8A7A5A" FontSize="13"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="ПОВТОРИТЬ" Width="170" Height="46" FontSize="16"
                        Style="{StaticResource HudButton}" Command="{Binding ReplayCommand}" Margin="0,0,12,0" />
                <Button Content="НАЗАД" Width="130" Height="46" FontSize="16"
                        Style="{StaticResource HudButton}" Command="{Binding BackCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="4" Background="#CC0E0A08"
                Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="900">
                <TextBlock Text="ЗАХВАТ ИМЕНИЯ НЕДОСТУПЕН" Foreground="#E8D9B0" FontSize="26"
                           FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorText}" Foreground="#E0B0B0" FontSize="14"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
