<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.EstateReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sektor.DarkestDungeon.Wpf.ViewModels"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A7A5A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8A7A5A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C0B0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6A5A4A" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <DataTemplate x:Key="ResourceTemplate" DataType="{x:Type vm:EstateResourceViewModel}">
            <Border Background="#241A12" BorderBrush="#3A2E22" BorderThickness="1"
                    CornerRadius="4" Padding="10,5" Margin="0,0,6,0">
                <TextBlock Text="{Binding Label}" Foreground="#E8D9B0" FontSize="13" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BuildingTemplate" DataType="{x:Type vm:EstateBuildingViewModel}">
            <Border Width="210" MinHeight="104" Background="#241A12" BorderBrush="#3A2E22"
                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,10,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontWeight="Bold"
                               FontSize="14" TextTrimming="CharacterEllipsis" />

                    <ProgressBar Grid.Row="1" Height="8" Margin="0,10,0,6" Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Foreground="#B08A50" Background="#1A120C" VerticalAlignment="Center" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="АПГРЕЙДЫ" Foreground="#6A5A4A" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#E8D9B0"
                                   FontSize="13" FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HeroTemplate" DataType="{x:Type vm:EstateHeroViewModel}">
            <Border Padding="12" Margin="0,0,0,8" CornerRadius="6" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#241A12" />
                        <Setter Property="BorderBrush" Value="#3A2E22" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDead}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontWeight="Bold"
                                       FontSize="14" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ClassLabel}" Foreground="#8A7A5A" FontSize="12"
                                       Margin="8,1,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding LevelText}" Foreground="#E8D9B0"
                                   FontSize="12" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HP" Foreground="#6A5A4A" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Minimum="0" Maximum="{Binding MaxHp, Mode=OneWay}"
                                     Value="{Binding Hp, Mode=OneWay}" Height="8" Margin="8,0"
                                     Foreground="#B05050" Background="#1A120C" />
                        <TextBlock Grid.Column="2" Text="{Binding HpText}" Style="{StaticResource BodyText}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="СТРЕСС" Foreground="#6A5A4A" FontSize="10" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StressText}" Foreground="#E0B0B0" FontSize="12"
                                       Margin="6,0,0,0" />
                        </StackPanel>
                        <Border Background="#3A2E22" CornerRadius="3" Padding="6,1" Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding ConditionText, Converter={StaticResource StringToVisibility}}">
                            <TextBlock Text="{Binding ConditionText}" Foreground="#E0B0B0" FontSize="10"
                                       FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding QuirksText}" Style="{StaticResource BodyText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding QuirksText, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding DiseasesText}" Foreground="#B07070" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding DiseasesText, Converter={StaticResource StringToVisibility}}" />
                        <TextBlock Text="{Binding StatusText}" Foreground="#8A7A5A" FontSize="11"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TimelineTemplate" DataType="{x:Type vm:CaptureTimelineEntryViewModel}">
            <TextBlock Text="{Binding Label}" Padding="4,2" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#8A7A5A" />
                        <Setter Property="FontSize" Value="11" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Foreground" Value="#E8D9B0" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPast}" Value="True">
                                <Setter Property="Foreground" Value="#5A4E3E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#14100C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ScreenHeaderView Grid.Row="0" Margin="48,24,48,0"
                                Title="{Binding ScreenTitle}"
                                Subtitle="{Binding CaptureSubtitle}"
                                CloseCommand="{Binding BackCommand}" />

        <!-- Week + resources + town event -->
        <Border Grid.Row="1" Margin="48,12,48,0" Padding="14,10" CornerRadius="8"
                Background="#1A120C" BorderBrush="#3A2E22" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="НЕДЕЛЯ" Foreground="#8A7A5A" FontSize="11" FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Week}" Foreground="#E8D9B0" FontSize="18" FontWeight="Bold"
                               Margin="8,0,20,0" />
                </StackPanel>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Resources}" Margin="20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ResourceTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2" Text="{Binding TownEventText}" Foreground="#E0B0B0"
                           FontSize="12" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Buildings left/center, heroes on the right -->
        <Grid Grid.Row="2" Margin="48,12,48,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="ЗДАНИЯ" Style="{StaticResource PanelTitle}" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Buildings}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <StaticResource ResourceKey="BuildingTemplate" />
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Зданий нет — сцена имения не записалась.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Buildings.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource OverlayPanel}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ГЕРОИ" Style="{StaticResource PanelTitle}" />
                        <TextBlock Grid.Column="1" Foreground="#8A7A5A" FontSize="11"
                                   Text="{Binding Roster.Count, StringFormat={}{0} чел.}"
                                   VerticalAlignment="Center" Margin="0,0,0,6" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Roster}">
                                <ItemsControl.ItemTemplate>
                                    <StaticResource ResourceKey="HeroTemplate" />
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Ростер пуст.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Roster.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Timeline and audio log at the bottom -->
        <Grid Grid.Row="3" Margin="48,12,48,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0" Style="{StaticResource OverlayPanel}" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="ТАЙМЛАЙН" Style="{StaticResource PanelTitle}" />
                    <ListBox x:Name="TimelineList" Grid.Row="1" Height="120"
                             ItemsSource="{Binding Timeline}"
                             SelectedItem="{Binding CurrentEntry, Mode=OneWay}"
                             SelectionChanged="OnTimelineSelectionChanged"
                             Loaded="OnTimelineLoaded"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="TimelineTemplate" />
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource OverlayPanel}" Padding="12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="АУДИО" Style="{StaticResource PanelTitle}" />
                    <ListBox Grid.Row="1" Height="120" ItemsSource="{Binding AudioLog}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <StaticResource ResourceKey="TimelineTemplate" />
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="48,12,48,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusText}" Foreground="#8A7A5A" FontSize="13"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="ПОВТОРИТЬ" Width="170" Height="46" FontSize="16"
                        Style="{StaticResource HudButton}" Command="{Binding ReplayCommand}" Margin="0,0,12,0" />
                <Button Content="НАЗАД" Width="130" Height="46" FontSize="16"
                        Style="{StaticResource HudButton}" Command="{Binding BackCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.RowSpan="5" Background="#B30E0A08"
                Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}">
            <Border Style="{StaticResource OverlayPanel}" Padding="24" MaxWidth="760"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="ЗАХВАТ ИМЕНИЯ НЕДОСТУПЕН" Foreground="#E8D9B0" FontSize="24"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorText}" Foreground="#E0B0B0" FontSize="14"
                               TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Запишите город в Unity (сцена EstateManagement) и откройте экран заново."
                               Foreground="#8A7A5A" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
