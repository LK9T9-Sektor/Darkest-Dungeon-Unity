<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleUnitCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             x:Name="Root">
    <Border Margin="6" Padding="8" CornerRadius="8" BorderThickness="2">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#241A12" />
                <Setter Property="BorderBrush" Value="#3A2E22" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsEnemy, ElementName=Root}" Value="True">
                        <Setter Property="Background" Value="#2E1714" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsAttacker, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="#E8D9B0" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsTarget, ElementName=Root}" Value="True">
                        <Setter Property="BorderBrush" Value="#B05050" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDead, ElementName=Root}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Rank, ElementName=Root}"
                           Foreground="#E8D9B0" FontSize="14" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="3" Padding="5,1" Background="#E8D9B0" Margin="0,0,4,0"
                            Visibility="{Binding IsAttacker, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="АТАКА" Foreground="#14100C" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <Border CornerRadius="3" Padding="5,1" Background="#B05050"
                            Visibility="{Binding IsTarget, ElementName=Root, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="ЦЕЛЬ" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" />
                    </Border>
                </StackPanel>
                <Button Grid.Column="2" Content="i" FontWeight="Bold" FontSize="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        ToolTip="Buffs and debuffs"
                        AutomationProperties.Name="Buffs and debuffs"
                        Command="{Binding InfoCommand, ElementName=Root}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                            <Setter Property="Width" Value="30" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Background" Value="#2A2218" />
                            <Setter Property="BorderBrush" Value="#4A3E2C" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InfoCommand, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,8,0,8" MinHeight="120">
                <views:SpineHeroControl ContentDirectory="{Binding ContentDirectory, ElementName=Root}"
                                        Loop="{Binding Loop, ElementName=Root}"
                                        AnimationCompletedCommand="{Binding AnimationCompletedCommand, ElementName=Root}"
                                        Visibility="{Binding HasSpineContent, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                <Border BorderBrush="#4A3A2E" BorderThickness="1" CornerRadius="6"
                        Background="#1A120C"
                        Visibility="{Binding HasSpineContent, ElementName=Root, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Skeleton, ElementName=Root}" Foreground="#8A7A5A" FontSize="11"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="карточка" Foreground="#6A5A4A" FontSize="10"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2">
                <Grid>
                    <ItemsControl ItemsSource="{Binding HpSegments, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Height="12" Margin="1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="#2A2A2A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="1">
                                                    <Setter Property="Fill" Value="#8A3A2A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="#E8D9B0" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="Hp" ElementName="Root" />
                                <Binding Path="MaxHp" ElementName="Root" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
                <Grid Margin="0,4,0,0">
                    <ItemsControl ItemsSource="{Binding StressSegments, ElementName=Root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Height="9" Margin="1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Fill" Value="#2A2A2A" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="1">
                                                    <Setter Property="Fill" Value="#5A7A9A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="#C8C0B0" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="Stress" ElementName="Root" />
                                <Binding Path="MaxStress" ElementName="Root" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
