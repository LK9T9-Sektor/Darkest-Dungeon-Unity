<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.UnitHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Reusable unit header: rank badge (left), colored name + optional class, optional close
         button (right), dark strip with a bottom separator line. Used on the duel card, the
         buff/debuff popup and the character stats sheet. -->
    <Border Background="#1A1410" BorderBrush="#3A2E22" BorderThickness="0,0,0,2" Padding="6,4,6,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- RANK BADGE -->
            <Border Width="32" Height="26" Background="#3A3022" BorderBrush="#6A5A3A" BorderThickness="1"
                    CornerRadius="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Rank, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#E8D9B0" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- NAME + CLASS -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,8,0">
                <TextBlock Text="{Binding DisplayName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                           TextAlignment="Left">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#C96A5A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                    <Setter Property="Foreground" Value="#6A8AC9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ClassName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="#C8C0B0" FontSize="14" Margin="10,2,0,0"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           Visibility="{Binding ClassName, RelativeSource={RelativeSource AncestorType=UserControl},
                                        Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <!-- CLOSE BUTTON (only when a close command is provided) -->
            <Button x:Name="CloseButton" Grid.Column="2" Content="&#x2715;" Width="28" Height="28"
                    FontWeight="Bold" Style="{StaticResource HudButton}" VerticalAlignment="Center"
                    Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
    </Border>
</UserControl>