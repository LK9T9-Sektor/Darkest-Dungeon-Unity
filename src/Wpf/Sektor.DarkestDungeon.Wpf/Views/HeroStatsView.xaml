<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C0B0" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8D9B0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- Detail sections (skills/resistances/quirks) shown only in the right-click stat sheet -->
        <Style x:Key="DetailSection" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowFullDetails, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header (hidden when the host supplies its own header via UnitHeaderView) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal"
                    Visibility="{Binding ShowHeader, RelativeSource={RelativeSource AncestorType=UserControl},
                                 Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding HeroName}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding HeroClass}" Foreground="#C8C0B0" FontSize="14" Margin="10,2,0,0" />
        </StackPanel>

        <!-- Stat table: 4 rows x 2 columns, label left / value right, columns stretch -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HP" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding HitPoints}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stress" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Stress}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Speed}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Damage" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ACC" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Accuracy}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Crit" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Crit}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Dodge" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Dodge}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Prot" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Protection}" Style="{StaticResource StatValue}" />
            </Grid>
        </Grid>

        <!-- Equipment: one compact row -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="40" Height="40" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="W" Foreground="#E8D9B0" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding WeaponLevel}" Foreground="#E8D9B0" FontSize="13"
                       VerticalAlignment="Center" Margin="8,0" />
            <Border Grid.Column="2" Width="40" Height="40" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="A" Foreground="#E8D9B0" FontSize="16"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding ArmorLevel}" Foreground="#E8D9B0" FontSize="13"
                       VerticalAlignment="Center" Margin="8,0" />
            <Border Grid.Column="4" Width="32" Height="32" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center" Margin="8,0,4,0" />
            <Border Grid.Column="5" Width="32" Height="32" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- All combat skills, each a reusable skill square with a structured tooltip -->
        <TextBlock Grid.Row="3" Text="SKILLS" Style="{StaticResource DetailSection}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="14"
                   FontWeight="Bold" Margin="0,10,0,0" />
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Skills}" Style="{StaticResource DetailSection}" Margin="0,2,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:SkillSquareView Margin="2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- All resistances, aligned in two column-pairs (label right-aligned value) -->
        <TextBlock Grid.Row="5" Text="RESISTANCES" Style="{StaticResource DetailSection}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="14"
                   FontWeight="Bold" Margin="0,10,0,0" />
        <Grid Grid.Row="6" Style="{StaticResource DetailSection}" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stun" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistStun, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Blight" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistBlight, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bleed" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistBleed, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Debuff" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistDebuff, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Move" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistMove, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Disease" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistDisease, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Death Blow" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistDeathBlow, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Trap" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding ResistTrap, StringFormat={}{0}%}" Style="{StaticResource StatValue}" />
            </Grid>
        </Grid>

        <!-- Quirks -->
        <TextBlock Grid.Row="7" Text="QUIRKS" Style="{StaticResource DetailSection}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="14"
                   FontWeight="Bold" Margin="0,10,0,0" />
        <TextBlock Grid.Row="8" Text="{Binding QuirksText}" Style="{StaticResource DetailSection}" Foreground="#C8C0B0" FontSize="13"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
