<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C0B0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8D9B0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="{Binding HeroName}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding HeroClass}" Foreground="#C8C0B0" FontSize="15" Margin="10,2,0,0" />
        </StackPanel>

        <!-- Stat table: 4 rows x 2 columns, label left / value right, columns stretch -->
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HP" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding HitPoints}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="0" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Stress" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Stress}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Speed" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Speed}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Damage" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ACC" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Accuracy}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Crit" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Crit}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="0" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Dodge" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Dodge}" Style="{StaticResource StatValue}" />
            </Grid>
            <Grid Grid.Row="3" Grid.Column="1" Margin="0,1,10,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Prot" Style="{StaticResource StatLabel}" />
                <TextBlock Grid.Column="1" Text="{Binding Protection}" Style="{StaticResource StatValue}" />
            </Grid>
        </Grid>

        <!-- Equipment: one compact row -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="W" Foreground="#E8D9B0" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding WeaponLevel}" Foreground="#E8D9B0" FontSize="14"
                       VerticalAlignment="Center" Margin="8,0" />
            <Border Grid.Column="2" Width="44" Height="44" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="A" Foreground="#E8D9B0" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Grid.Column="3" Text="{Binding ArmorLevel}" Foreground="#E8D9B0" FontSize="14"
                       VerticalAlignment="Center" Margin="8,0" />
            <Border Grid.Column="4" Width="36" Height="36" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center" Margin="8,0,4,0" />
            <Border Grid.Column="5" Width="36" Height="36" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1"
                    VerticalAlignment="Center" />
        </Grid>

        <!-- All combat skills -->
        <TextBlock Grid.Row="3" Text="SKILLS" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="14"
                   FontWeight="Bold" Margin="0,10,0,0" />
        <TextBlock Grid.Row="4" Text="{Binding SkillsText}" Foreground="#C8C0B0" FontSize="13"
                   TextWrapping="Wrap" />

        <!-- All resistances -->
        <TextBlock Grid.Row="5" Text="RESISTANCES" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="14"
                   FontWeight="Bold" Margin="0,10,0,0" />
        <TextBlock Grid.Row="6" Text="{Binding ResistsText}" Foreground="#C8C0B0" FontSize="13"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
