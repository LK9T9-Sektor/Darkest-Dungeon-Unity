<views:PumpableScreenBase x:Class="Sektor.DarkestDungeon.Wpf.Views.DuelLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Width="1920" Height="1080"
             Background="#14100C"
             TextElement.Foreground="White">
    <Grid Margin="64,48,64,40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + close cross -->
        <views:ScreenHeaderView Grid.Row="0"
                                Title="MULTIPLAYER &#x2014; PICK 4 HEROES"
                                CloseCommand="{Binding LeaveCommand}" />

        <!-- Row 1: player's four hero slots -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,8,0,0">
            <views:HeroSlotsPanel Slots="{Binding Slots}" />
        </StackPanel>

        <!-- Row 2: second player / connection area (hero picking is inactive for live PvP) -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#D9B46A" FontSize="20" MaxWidth="900" />
            <TextBlock Text="{Binding WaitingTime}" FontSize="16" Foreground="#8A7A5A"
                       HorizontalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>

        <!-- Row 3 (bottom): session controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,8">
            <TextBox Text="{Binding SessionIdText, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Height="38" VerticalContentAlignment="Center"
                     Background="#2B2B2B" BorderBrush="#555" Foreground="White" FontSize="16" />
            <Button Content="Host" Width="90" Height="38" Margin="10,0,0,0" FontSize="16"
                    Style="{StaticResource HudButton}" Command="{Binding HostCommand}" />
            <Button Content="Join" Width="90" Height="38" Margin="8,0,0,0" FontSize="16"
                    Style="{StaticResource HudButton}" Command="{Binding JoinCommand}" />
            <Button Content="Copy ID" Width="100" Height="38" Margin="8,0,0,0" FontSize="16"
                    Style="{StaticResource HudButton}" Command="{Binding CopyIdCommand}" />
        </StackPanel>
    </Grid>
</views:PumpableScreenBase>