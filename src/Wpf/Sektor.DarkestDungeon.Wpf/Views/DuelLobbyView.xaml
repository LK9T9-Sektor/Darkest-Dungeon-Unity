<views:PumpableScreenBase x:Class="Sektor.DarkestDungeon.Wpf.Views.DuelLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Width="1100" Height="560"
             Background="#1E1E1E"
             TextElement.Foreground="White">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- LEFT: title + hero slots -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="MULTIPLAYER — PICK 4 HEROES" FontSize="20" Margin="0,0,0,12" Foreground="#E8D9B0" />
            <views:HeroSlotsPanel Slots="{Binding Slots}" />
        </StackPanel>

        <!-- RIGHT: session + actions -->
        <StackPanel Grid.Column="1" Margin="32,0,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,42,0,0" Foreground="#D9B46A" />
            <TextBlock Text="{Binding WaitingTime}" FontSize="14" Foreground="#8A7A5A" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox Text="{Binding SessionIdText, UpdateSourceTrigger=PropertyChanged}"
                         Width="220" VerticalContentAlignment="Center"
                         Background="#2B2B2B" BorderBrush="#555" Foreground="White" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Host" Width="70" Command="{Binding HostCommand}" />
                <Button Content="Join" Width="70" Margin="8,0,0,0" Command="{Binding JoinCommand}" />
                <Button Content="Copy ID" Width="70" Margin="8,0,0,0" Command="{Binding CopyIdCommand}" />
            </StackPanel>

            <Button Content="Leave and Back" Width="140" Height="30" Margin="0,22,0,0"
                    HorizontalAlignment="Left" Command="{Binding LeaveCommand}" />
        </StackPanel>
    </Grid>
</views:PumpableScreenBase>
