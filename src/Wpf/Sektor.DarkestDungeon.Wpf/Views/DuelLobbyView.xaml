<views:PumpableScreenBase x:Class="Sektor.DarkestDungeon.Wpf.Views.DuelLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             Background="#14100C"
             TextElement.Foreground="White">
    <Grid Margin="40,24,40,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + close cross -->
        <views:ScreenHeaderView Grid.Row="0"
                                Title="МУЛЬТИПЛЕЕР &#x2014; СФОРМИРУЙТЕ ОТРЯД"
                                CloseCommand="{Binding LeaveCommand}" />

        <!-- Player party -->
        <views:PartySelectionView Grid.Row="1" PlayerLabel="#1 Player" Slots="{Binding Slots}"
                                  Margin="0,16,0,0" />

        <!-- Connection / second player status -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="#D9B46A" FontSize="18" MaxWidth="900" />
            <TextBlock Text="{Binding WaitingTime}" FontSize="15" Foreground="#8A7A5A"
                       HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>

        <!-- Bottom: session controls -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,4">
            <TextBox Text="{Binding SessionIdText, UpdateSourceTrigger=PropertyChanged}"
                     Width="240" Height="38" VerticalContentAlignment="Center"
                     Background="#2B2B2B" BorderBrush="#555" Foreground="White" FontSize="15" />
            <Button Content="Host" Width="90" Height="38" Margin="10,0,0,0" FontSize="15"
                    Style="{StaticResource HudButton}" Command="{Binding HostCommand}" />
            <Button Content="Join" Width="90" Height="38" Margin="8,0,0,0" FontSize="15"
                    Style="{StaticResource HudButton}" Command="{Binding JoinCommand}" />
            <Button Content="Copy ID" Width="100" Height="38" Margin="8,0,0,0" FontSize="15"
                    Style="{StaticResource HudButton}" Command="{Binding CopyIdCommand}" />
        </StackPanel>
    </Grid>
</views:PumpableScreenBase>