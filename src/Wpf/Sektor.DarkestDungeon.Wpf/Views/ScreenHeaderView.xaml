<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.ScreenHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <!-- Close (back) cross, always top-left -->
        <Button Content="X" Width="38" Height="38" FontSize="18" FontWeight="Bold"
                Foreground="#C0392B" Style="{StaticResource HudButton}" ToolTip="Close"
                Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!-- Title panel, flush next to the cross -->
        <Border Style="{StaticResource OverlayPanel}" Padding="16,8" Margin="10,0,0,0">
            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="#E8D9B0" FontSize="20" FontWeight="Bold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </Border>
    </StackPanel>
</UserControl>