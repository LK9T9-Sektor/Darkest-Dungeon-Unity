<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.ScreenHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="#E8D9B0" FontSize="26" FontWeight="Bold"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <!-- Close (back) cross, same chrome as the battle-screen retreat button -->
        <Button Grid.Column="1" Content="X" Width="38" Height="38" FontSize="18" FontWeight="Bold"
                Foreground="#C0392B" Style="{StaticResource HudButton}" ToolTip="Back"
                Command="{Binding CloseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>