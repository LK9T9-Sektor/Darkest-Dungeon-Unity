<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleTargetOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Canvas x:Name="TargetLayer" ClipToBounds="False"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <views:SkillSquareView x:Name="SkillBadge" ShowName="True"
                               Visibility="Collapsed" />

        <!-- Move swap arrow: a straight line between the two card centers with an
             arrowhead at each end (⇄), because moving exchanges ranks. -->
        <Line x:Name="ArrowLine" Stroke="#D9B46A" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
              IsHitTestVisible="False" />
        <Polygon x:Name="ArrowHead" Fill="#D9B46A" Visibility="Collapsed" IsHitTestVisible="False" />
        <Polygon x:Name="ArrowHeadReverse" Fill="#D9B46A" Visibility="Collapsed" IsHitTestVisible="False" />

        <!-- Skill elbow arrows: from the actor card top edge up to the skill badge,
             out of its left/right edge horizontally, then down into the target top
             edge. One arrow per target (up to four), colored by the skill tone. -->
        <Path x:Name="SkillArrow1" StrokeLineJoin="Round" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeThickness="3" Visibility="Collapsed"
              IsHitTestVisible="False" />
        <Polygon x:Name="SkillArrowHead1" Visibility="Collapsed" IsHitTestVisible="False" />
        <Path x:Name="SkillArrow2" StrokeLineJoin="Round" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeThickness="3" Visibility="Collapsed"
              IsHitTestVisible="False" />
        <Polygon x:Name="SkillArrowHead2" Visibility="Collapsed" IsHitTestVisible="False" />
        <Path x:Name="SkillArrow3" StrokeLineJoin="Round" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeThickness="3" Visibility="Collapsed"
              IsHitTestVisible="False" />
        <Polygon x:Name="SkillArrowHead3" Visibility="Collapsed" IsHitTestVisible="False" />
        <Path x:Name="SkillArrow4" StrokeLineJoin="Round" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeThickness="3" Visibility="Collapsed"
              IsHitTestVisible="False" />
        <Polygon x:Name="SkillArrowHead4" Visibility="Collapsed" IsHitTestVisible="False" />
    </Canvas>
</UserControl>
