<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.CaptureReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sektor.DarkestDungeon.Wpf.ViewModels"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <UserControl.Resources>
        <!-- Shared combatant card: position, attack/target state, Spine art, HP and stress. -->
        <DataTemplate x:Key="UnitTemplate" DataType="{x:Type vm:CaptureUnitViewModel}">
            <views:BattleUnitCardView Rank="{Binding Rank}"
                                      Hp="{Binding Hp}"
                                      MaxHp="{Binding MaxHp}"
                                      Stress="{Binding Stress}"
                                      MaxStress="{Binding MaxStress}"
                                      ContentDirectory="{Binding ContentDirectory}"
                                      Loop="{Binding Loop}"
                                      Skeleton="{Binding Skeleton}"
                                      IsEnemy="{Binding IsEnemy}"
                                      IsAttacker="{Binding IsAttacker}"
                                      IsTarget="{Binding IsTarget}"
                                      IsDead="{Binding IsDead}"
                                      AnimationCompletedCommand="{Binding DataContext.AnimationCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#14100C">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:ScreenHeaderView Grid.Row="0" Margin="48,24,48,0"
                                Title="{Binding ScreenTitle}"
                                Subtitle="{Binding CaptureSubtitle}"
                                CloseCommand="{Binding BackCommand}" />

        <views:BattleSceneBarView Grid.Row="1" Margin="48,12,48,0"
                                  Scene="{Binding SceneName}"
                                  Room="{Binding RoomName}"
                                  RoomType="{Binding RoomType}"
                                  Round="{Binding Round}"
                                  Turn="{Binding Turn}"
                                  Torch="{Binding Torch}"
                                  Gold="{Binding Gold}" />

        <!-- Battlefield: heroes (rank 4..1) left, monsters (rank 1..n) right -->
        <Border Grid.Row="2" Margin="48,16,48,0"
                Background="#0E0B08" BorderBrush="#3A2E22" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="10,8,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ПАРТИЯ" Style="{StaticResource PanelCaption}"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PartyFormation}"
                                  ItemTemplate="{StaticResource UnitTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <TextBlock Grid.Column="1" Text="VS" FontSize="26" FontWeight="Bold"
                           Foreground="#5A4A3A" VerticalAlignment="Center" Margin="8,0" />

                <Grid Grid.Column="2" Margin="10,8,10,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="ВРАГИ" Style="{StaticResource PanelCaption}"
                               HorizontalAlignment="Center" Margin="0,0,0,4" />
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Enemies}"
                                  ItemTemplate="{StaticResource UnitTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom bar: buttons left, status center, event log right -->
        <Grid Grid.Row="3" Margin="48,12,48,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="ПОВТОРИТЬ" Width="180" Height="48" FontSize="16"
                        Style="{StaticResource HudButton}" Command="{Binding ReplayCommand}"
                        ToolTip="Restarts the replay from the first recorded event" />
                <Button Width="160" Height="48" FontSize="16" Margin="12,0,0,0"
                        Command="{Binding TogglePauseCommand}"
                        ToolTip="Pauses or resumes the replay">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HudButton}">
                            <Setter Property="Content" Value="ПАУЗА" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                    <Setter Property="Content" Value="ПРОДОЛЖИТЬ" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="НАЗАД" Width="140" Height="48" FontSize="16" Margin="12,0,0,0"
                        Style="{StaticResource HudButton}" Command="{Binding BackCommand}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="24,6,24,0">
                <TextBlock Text="{Binding StatusText}" Foreground="#C8C0B0" FontSize="14" />
                <TextBlock Text="{Binding BattleWinner}" Foreground="#D8A050" FontSize="13"
                           FontWeight="Bold" Margin="0,4,0,0" />
                <TextBlock Text="Тайминг: одно событие в 100 мс, атака держится 1,2 с."
                           Foreground="#6A5A4A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Border Style="{StaticResource OverlayPanel}" Padding="8" Margin="0,10,0,0" MaxHeight="96">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="АУДИО"
                                   Style="{StaticResource PanelCaption}" Margin="0,0,0,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding AudioLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" Foreground="#8A7A5A"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource OverlayPanel}" Padding="10" Height="190"
                    HorizontalAlignment="Stretch">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="ЖУРНАЛ СОБЫТИЙ"
                               Style="{StaticResource PanelCaption}" Margin="0,0,0,4" />
                    <ListBox x:Name="TimelineList" ItemsSource="{Binding Timeline}"
                             SelectedItem="{Binding CurrentEntry, Mode=OneWay}"
                             SelectionChanged="OnTimelineSelectionChanged"
                             Loaded="OnTimelineLoaded"
                             VirtualizingPanel.IsVirtualizing="False"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="11" TextWrapping="Wrap" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#8A7A5A" />
                                            <Setter Property="Opacity" Value="0.45" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                                    <Setter Property="Foreground" Value="#C8C0B0" />
                                                    <Setter Property="Opacity" Value="0.8" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="#E8D9B0" />
                                                    <Setter Property="Opacity" Value="1" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Reader error covers the scene when the capture cannot be loaded -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="#D0200A0A" BorderBrush="#8A2E2E"
                BorderThickness="2" Margin="48,12,48,0"
                Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibility}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="720">
                <TextBlock Text="НЕ УДАЛОСЬ ПРОЧИТАТЬ ЗАХВАТ" Foreground="#E8D9B0"
                           FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ErrorText}" Foreground="#E0B0B0" FontSize="14"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
