<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.SkillSquareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <!-- Reusable skill square: an icon slot with the skill name below (unless ShowName is false) and a
         structured tooltip on hover. Bound to a DuelSkillViewModel (Icon/DisplayNameUpper/IsUsable/
         IsSelected). The host may supply a SelectCommand to make the square a clickable button (skill
         tray); without one it renders as a read-only inspection square (character-info sheet, floating
         badge). -->
    <StackPanel x:Name="RootPanel" Width="58">
        <Button x:Name="SkillButton" Width="50" Height="50" Padding="2"
                HorizontalAlignment="Center"
                ToolTipService.Placement="Top"
                ToolTipService.ShowOnDisabled="True"
                Template="{StaticResource SkillButtonTemplate}">
            <Button.ToolTip>
                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <views:SkillTooltipView />
                </ToolTip>
            </Button.ToolTip>
            <Grid>
                <Image Source="{Binding Icon}" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <!-- Fallback for skills without a bundled icon (monster skills): tone fill + initials. -->
                <Border Background="{Binding ToneBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Initials}" Foreground="#FFFFFF" FontWeight="Bold"
                               FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Rectangle Fill="#B0606060"
                           Visibility="{Binding IsMasked, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Button>
        <TextBlock x:Name="NameLabel" Text="{Binding DisplayNameUpper}" FontSize="8" Height="20"
                   Foreground="#C8C0B0" TextAlignment="Center" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        <TextBlock x:Name="LevelLabel" Text="{Binding Level}" FontSize="11" Height="16"
                   Foreground="#E8D9B0" FontWeight="Bold" TextAlignment="Center"
                   Margin="0,2,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
