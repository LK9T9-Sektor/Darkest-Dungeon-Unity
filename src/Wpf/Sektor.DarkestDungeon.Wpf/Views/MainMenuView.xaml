<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1280" Height="720">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14100C" Offset="0" />
                <GradientStop Color="#241A12" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Decorative top/bottom lines like the game menu frame -->
        <Border VerticalAlignment="Top" Height="2" Margin="60,48,60,0" Background="#3A2E22" />
        <Border VerticalAlignment="Bottom" Height="2" Margin="60,0,60,48" Background="#3A2E22" />

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="DARKEST DUNGEON" FontSize="52" FontWeight="Bold" Foreground="#E8D9B0"
                       HorizontalAlignment="Center" />
            <TextBlock Text="choose your battle" FontSize="18" Foreground="#8A7A5A"
                       HorizontalAlignment="Center" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,64,0,0">
                <Button Content="VS AI" Width="230" Height="58" FontSize="20"
                        Margin="0,0,36,0" Style="{StaticResource HudButton}"
                        Command="{Binding VsAiCommand}" />
                <Button Content="MULTIPLAYER" Width="230" Height="58" FontSize="20"
                        Style="{StaticResource HudButton}"
                        Command="{Binding MultiplayerCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
