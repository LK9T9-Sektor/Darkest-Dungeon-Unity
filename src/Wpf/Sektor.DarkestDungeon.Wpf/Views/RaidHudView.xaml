<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.RaidHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <Border Background="{StaticResource AreaBackground}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="0,2,0,0">
        <Grid Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="707" />
            </Grid.ColumnDefinitions>

            <!-- Left: framed hero info, flush with the left field border -->
            <views:HeroInfoPanelView Grid.Column="0" DataContext="{Binding RaidHud}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" />

            <!-- Center: unit tooltip, sized to its content and right-aligned toward the right panel -->
            <views:UnitTooltipView Grid.Column="1" DataContext="{Binding TooltipTarget}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="600" />

            <!-- Right: log/inventory/map pinned to the top, buttons in their own row below -->
            <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <views:LogView DataContext="{Binding}"
                                   Visibility="{Binding DataContext.RaidHud.IsLogShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                    <views:InventoryView DataContext="{Binding RaidHud.Inventory}"
                                         Visibility="{Binding DataContext.RaidHud.IsInventoryShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                    <views:MapView DataContext="{Binding RaidHud.Map}"
                                   Visibility="{Binding DataContext.RaidHud.IsMapShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="LOG" Command="{Binding RaidHud.ShowLogCommand}" Margin="0,0,8,0"
                            Style="{StaticResource HudButton}" Padding="14,4" FontSize="16" />
                    <Button Content="INVENTORY" Command="{Binding RaidHud.ShowInventoryCommand}" Margin="0,0,8,0"
                            Style="{StaticResource HudButton}" Padding="14,4" FontSize="16" />
                    <Button Content="MAP" Command="{Binding RaidHud.ShowMapCommand}"
                            Style="{StaticResource HudButton}" Padding="14,4" FontSize="16" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>