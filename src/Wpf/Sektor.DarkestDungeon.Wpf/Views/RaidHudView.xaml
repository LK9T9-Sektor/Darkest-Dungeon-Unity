<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.RaidHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <Border Background="{StaticResource AreaBackground}" BorderBrush="{StaticResource FieldBorder}" BorderThickness="0,2,0,0">
        <Grid Margin="8,8,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: hero info, filling the HUD height (content pinned to the bottom) -->
            <views:HeroInfoPanelView Grid.Column="0" DataContext="{Binding RaidHud}"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

            <!-- Center: unit tooltip, stretching to fill the column -->
            <views:UnitTooltipView Grid.Column="1" DataContext="{Binding TooltipTarget}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="12,0,12,0" />

            <!-- Right: log/inventory/map, filling the HUD height -->
            <Grid Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <views:LogView DataContext="{Binding}"
                               Visibility="{Binding DataContext.RaidHud.IsLogShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                <views:InventoryView DataContext="{Binding RaidHud.Inventory}"
                                     Visibility="{Binding DataContext.RaidHud.IsInventoryShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                <views:MapView DataContext="{Binding RaidHud.Map}"
                               Visibility="{Binding DataContext.RaidHud.IsMapShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>