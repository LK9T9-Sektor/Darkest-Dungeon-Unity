<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">

    <!-- Spacing tokens: single source for margins and paddings -->
    <Thickness x:Key="SpacingTight">4</Thickness>
    <Thickness x:Key="SpacingSmall">8</Thickness>
    <Thickness x:Key="SpacingMedium">12</Thickness>

    <!-- Top offsets of the floating top bars -->
    <Thickness x:Key="TopBarOffset">0,12,0,0</Thickness>

    <!-- Common area background: top (quest/torch/turn order) and bottom (raid info) bars -->
    <SolidColorBrush x:Key="AreaBackground" Color="#C8000000" />

    <!-- Battle field background and border -->
    <SolidColorBrush x:Key="FieldBackground" Color="#0C0C0C" />
    <SolidColorBrush x:Key="FieldBorder" Color="#3A2E22" />

    <!-- Shared overlay panel chrome -->
    <Style x:Key="OverlayPanel" TargetType="Border">
        <Setter Property="Background" Value="#A0000000" />
        <Setter Property="BorderBrush" Value="#3A2E22" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- Shared HUD button chrome -->
    <Style x:Key="HudButton" TargetType="Button">
        <Setter Property="Background" Value="{x:Static ui:UiBrushes.ButtonBackground}" />
        <Setter Property="Foreground" Value="{x:Static ui:UiBrushes.Label}" />
    </Style>

    <!-- Darkest Dungeon styled tooltip popup -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#E6000000" />
        <Setter Property="Foreground" Value="#E8D9B0" />
        <Setter Property="BorderBrush" Value="#3A2E22" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MaxWidth" Value="420" />
    </Style>

    <!-- Combat skill square chrome: battle usable = golden frame; loadout selected = orange frame;
         loadout unselected = grey frame; unusable = grey frame. The icon stays visible under a
         semi-transparent mask. Bound to an ISkillTileViewModel (IsUsable/IsSelected/IsLoadout). -->
    <ControlTemplate x:Key="SkillButtonTemplate" TargetType="Button">
        <Border x:Name="Chrome" Background="#2A2218" BorderBrush="#D9B46A" BorderThickness="2"
                CornerRadius="4" Padding="2">
            <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUsable}" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#202020" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A6A6A" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3A2A18" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#D98A3A" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsLoadout}" Value="True" />
                    <Condition Binding="{Binding IsSelected}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Chrome" Property="Background" Value="#202020" />
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A6A6A" />
            </MultiDataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#E8D9B0" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#3A3022" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A6A6A" />
                <Setter TargetName="Chrome" Property="Background" Value="#202020" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>
