<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- src\Directory.Build.props pins src to C# 7.3; the WPF client overrides it (client-zone carve-out). -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sektor.DarkestDungeon.Wpf</RootNamespace>
    <AssemblyName>Sektor.DarkestDungeon.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="3.1.12" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- Bundled hero class definitions consumed by the core parser at runtime (linked from unity content, not duplicated). -->
  <ItemGroup>
    <None Include="..\..\..\unity\Assets\Resources\Data\Heroes\Info\*.bytes"
          Link="Content\Heroes\%(Filename).bytes"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\JsonQuirks.json"
          Link="Content\Quirks\JsonQuirks.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\JsonBuffs.json"
          Link="Content\Buffs\JsonBuffs.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\Mechanics\Effects.txt"
          Link="Content\Effects\Effects.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\JsonTraits.json"
          Link="Content\Traits\JsonTraits.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\JsonAI.json"
          Link="Content\AI\JsonAI.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\unity\Assets\Resources\Data\Monsters\*.txt"
          Link="Content\Monsters\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Content\Sektor.DarkestDungeon.Core.Content.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Ui\Sektor.DarkestDungeon.Core.Ui.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Combat\Sektor.DarkestDungeon.Core.Combat.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Campaign\Sektor.DarkestDungeon.Core.Campaign.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Raid\Sektor.DarkestDungeon.Core.Raid.csproj" />
    <ProjectReference Include="..\..\Clients\Sektor.DarkestDungeon.Clients.Content\Sektor.DarkestDungeon.Clients.Content.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Duel\Sektor.DarkestDungeon.Core.Duel.csproj" />
    <ProjectReference Include="..\..\Lan\Sektor.DarkestDungeon.Lan.Contracts\Sektor.DarkestDungeon.Lan.Contracts.csproj" />
    <ProjectReference Include="..\..\Lan\Sektor.DarkestDungeon.Lan.Steam\Sektor.DarkestDungeon.Lan.Steam.csproj" />
  </ItemGroup>

  <Target Name="CopySteamRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\unity\Assets\Plugins\x86_64\steam_api64.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\unity\Assets\Plugins\x86_64\steam_api64.dll')" />
  </Target>

</Project>
