<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- src\Directory.Build.props pins src to C# 7.3; the WPF client overrides it (client-zone carve-out). -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sektor.DarkestDungeon.Wpf</RootNamespace>
    <AssemblyName>Sektor.DarkestDungeon.Wpf</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Content\Sektor.DarkestDungeon.Core.Content.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Ui\Sektor.DarkestDungeon.Core.Ui.csproj" />
    <ProjectReference Include="..\..\Core\Sektor.DarkestDungeon.Core.Combat\Sektor.DarkestDungeon.Core.Combat.csproj" />
    <ProjectReference Include="..\..\Lan\Sektor.DarkestDungeon.Lan.Contracts\Sektor.DarkestDungeon.Lan.Contracts.csproj" />
    <ProjectReference Include="..\..\Lan\Sektor.DarkestDungeon.Lan.Steam\Sektor.DarkestDungeon.Lan.Steam.csproj" />
  </ItemGroup>

  <Target Name="CopySteamRuntime" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\..\unity\Assets\Plugins\x86_64\steam_api64.dll"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\unity\Assets\Plugins\x86_64\steam_api64.dll')" />
  </Target>

</Project>
