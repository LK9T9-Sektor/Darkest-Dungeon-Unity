<Window x:Class="Sektor.DarkestDungeon.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
        Title="Darkest Dungeon — Battle Screen Mockup"
        Width="1280" Height="720"
        Background="Black"
        WindowStartupLocation="CenterScreen">
    <Viewbox Stretch="Uniform">
        <Grid>
            <views:BattleScreenView />
            <Button Content="Multiplayer Duel"
                    Width="180" Height="40"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0"
                    Background="#2B2B2B" Foreground="White" BorderBrush="#555"
                    Click="OpenDuelLobby_Click" />
        </Grid>
    </Viewbox>
</Window>
