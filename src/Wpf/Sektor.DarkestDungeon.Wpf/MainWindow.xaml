<Window x:Class="Sektor.DarkestDungeon.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sektor.DarkestDungeon.Wpf.ViewModels"
        xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
        Title="Darkest Dungeon"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        Background="Black"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenuView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MultiplayerLobbyViewModel}">
            <views:MultiplayerLobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuelLobbyViewModel}">
            <views:DuelLobbyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuelBattleViewModel}">
            <views:DuelBattleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpineDemoViewModel}">
            <views:SpineDemoView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SpineBattleViewModel}">
            <views:SpineBattleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CaptureReplayViewModel}">
            <views:CaptureReplayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EstateReplayViewModel}">
            <views:EstateReplayView />
        </DataTemplate>
    </Window.Resources>
    <ContentControl Content="{Binding CurrentScreen}" />
</Window>