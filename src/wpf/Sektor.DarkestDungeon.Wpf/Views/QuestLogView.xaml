<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.QuestLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Background="#A0000000" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="8">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="QUEST" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="20" FontWeight="Bold" />
                <TextBlock Text="{Binding Title}" Foreground="#E8D9B0" FontSize="20" Margin="16,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding Goal}" Foreground="#C8C0B0" FontSize="16"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <Button Grid.Row="2" Content="RETREAT" HorizontalAlignment="Right" Margin="0,10,0,0"
                    Command="{Binding RetreatCommand}"
                    IsEnabled="{Binding CanRetreat}"
                    Background="{x:Static ui:UiBrushes.ButtonBackground}"
                    Foreground="{x:Static ui:UiBrushes.Label}"
                    Padding="16,6" />
        </Grid>
    </Border>
</UserControl>
