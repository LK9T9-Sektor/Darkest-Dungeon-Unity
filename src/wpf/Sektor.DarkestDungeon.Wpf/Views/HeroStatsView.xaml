<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroStatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <UserControl.Resources>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#C8C0B0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8D9B0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding HeroName}" Foreground="{x:Static ui:UiBrushes.Label}"
                       FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding HeroClass}" Foreground="#C8C0B0" FontSize="17" />
        </StackPanel>

        <!-- Stat table: label left, value right, columns stretch -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="HP" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HitPoints}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Stress" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Stress}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Speed" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Speed}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Damage" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Damage}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="4" Grid.Column="0" Text="ACC" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Accuracy}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Crit" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Crit}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Dodge" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Dodge}" Style="{StaticResource StatValue}" />
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Prot" Style="{StaticResource StatLabel}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Protection}" Style="{StaticResource StatValue}" />
        </Grid>

        <!-- Equipment -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="EQUIPMENT" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="16" FontWeight="Bold" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Width="56" Height="56" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="W" Foreground="#E8D9B0" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="{Binding WeaponLevel}" Foreground="#E8D9B0" FontSize="15"
                           VerticalAlignment="Center" Margin="10,0" />
                <Border Grid.Column="2" Width="56" Height="56" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="A" Foreground="#E8D9B0" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding ArmorLevel}" Foreground="#E8D9B0" FontSize="15"
                           VerticalAlignment="Center" Margin="10,0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Border Width="44" Height="44" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1" Margin="0,0,8,0" />
                <Border Width="44" Height="44" Background="#3A2A2A" BorderBrush="#3A2E22" BorderThickness="1" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
