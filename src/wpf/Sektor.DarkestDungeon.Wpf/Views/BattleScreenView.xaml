<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui"
             Width="1920" Height="1080">
    <Grid Background="Black">
        <views:BattleViewport DataContext="{Binding}" />

        <views:TorchView DataContext="{Binding Torch}"
                         HorizontalAlignment="Center" VerticalAlignment="Top"
                         Width="722" Height="90" Margin="0,24,0,0" />

        <views:QuestLogView DataContext="{Binding QuestLog}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="360" Height="158" Margin="20,28,0,0" />

        <views:MonsterTooltipView DataContext="{Binding TooltipTarget}"
                                  HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Width="360" Height="330" Margin="0,180,140,0" />

        <!-- Stats sheet, opened by right-clicking a unit on the stage -->
        <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Width="560" Height="330" Margin="60,220,0,0"
              Visibility="{Binding IsStatsVisible, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#E6000000" BorderBrush="{x:Static ui:UiBrushes.Label}" BorderThickness="2"
                    CornerRadius="8">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Grid.Row="0" Content="X" Command="{Binding CloseStatsCommand}"
                            HorizontalAlignment="Right" Width="30" Height="30"
                            Background="{x:Static ui:UiBrushes.ButtonBackground}"
                            Foreground="{x:Static ui:UiBrushes.Label}" FontWeight="Bold" />
                    <views:HeroStatsView Grid.Row="1" DataContext="{Binding StatsTarget}" Margin="0,8,0,0" />
                </Grid>
            </Border>
        </Grid>

        <views:EventsLayerView DataContext="{Binding Events}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <views:RaidHudView DataContext="{Binding RaidHud}"
                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                           Height="360" />
    </Grid>
</UserControl>
