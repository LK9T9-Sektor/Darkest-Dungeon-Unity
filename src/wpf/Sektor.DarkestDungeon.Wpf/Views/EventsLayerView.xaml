<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.EventsLayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Grid IsHitTestVisible="False">
        <!-- Round indicator, over the battle field backdrop -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0">
            <TextBlock Text="ROUND" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="20"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Round}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="48" FontWeight="Bold"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Announcement banner -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,60,0,0"
                Background="#E6000000" BorderBrush="{x:Static ui:UiBrushes.Label}" BorderThickness="2"
                CornerRadius="8" Padding="40,12"
                Visibility="{Binding AnnouncementTitle, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding AnnouncementTitle}" Foreground="{x:Static ui:UiBrushes.Label}"
                       FontSize="30" FontWeight="Bold" />
        </Border>

        <!-- Popup message -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,420"
                Background="#E6000000" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="8"
                Padding="24,10"
                Visibility="{Binding PopupMessage, Converter={StaticResource StringToVisibility}}">
            <TextBlock Text="{Binding PopupMessage}" Foreground="#E8D9B0" FontSize="22" />
        </Border>
    </Grid>
</UserControl>
