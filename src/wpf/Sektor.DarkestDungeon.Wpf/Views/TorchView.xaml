<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.TorchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Background="#A0000000" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="8">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <TextBlock Text="Torch" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="22"
                       VerticalAlignment="Center" Width="90" />
            <Slider Minimum="0" Maximum="100" Value="{Binding TorchValue, Mode=TwoWay}"
                    Width="440" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TorchValue, StringFormat={}{0:0} / 100}" Foreground="#E8D9B0"
                       FontSize="22" VerticalAlignment="Center" Margin="16,0,0,0" Width="120" />
        </StackPanel>
    </Border>
</UserControl>
