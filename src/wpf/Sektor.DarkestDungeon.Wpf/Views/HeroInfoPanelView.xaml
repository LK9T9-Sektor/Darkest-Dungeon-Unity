<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroInfoPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views">
    <Border Style="{StaticResource OverlayPanel}">
        <StackPanel Margin="{StaticResource SpacingSmall}">
            <views:HeroBannerView DataContext="{Binding Hero}" />
            <views:HeroStatsView DataContext="{Binding Hero.Stats}" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
