<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.HeroBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Portrait + name/class, pinned to the top -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
            <Border Width="85" Height="85" Background="#5A4A3A" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="6">
                <TextBlock Text="?" Foreground="#E8D9B0" FontSize="40"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding Name}" Foreground="{x:Static ui:UiBrushes.Label}" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="{Binding ClassName}" Foreground="#C8C0B0" FontSize="16" />
            </StackPanel>
        </StackPanel>

        <!-- Skill slots: square icons with the name below, pinned to the top -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding BannerSkills}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,6,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="6" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="64" Margin="3">
                        <Border Width="58" Height="58" Background="{x:Static ui:UiBrushes.ButtonBackground}"
                                CornerRadius="4" BorderBrush="#3A2E22" BorderThickness="1" />
                        <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="11"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
