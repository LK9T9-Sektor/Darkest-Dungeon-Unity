<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Background="#80000000" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="8" Margin="0,44,0,0">
        <ItemsControl ItemsSource="{Binding Items}" Margin="14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="8" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="4" Background="#4A3A2A" BorderBrush="#3A2E22" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center" Margin="4">
                            <Border Width="48" Height="48" Background="#3A2A22" HorizontalAlignment="Center"
                                    BorderBrush="#2A2018" BorderThickness="1">
                                <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="10"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding DisplayText}" Foreground="#E8D9B0" FontSize="11"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
