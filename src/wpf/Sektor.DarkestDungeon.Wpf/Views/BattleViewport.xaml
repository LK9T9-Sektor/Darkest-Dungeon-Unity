<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.BattleViewport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14100C" Offset="0" />
                <GradientStop Color="#241A12" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Room backdrop placeholder -->
        <Border Width="1500" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#0C0C0C" BorderBrush="#3A2E22" BorderThickness="2" CornerRadius="12" />

        <!-- Player party (left of stage) -->
        <ItemsControl ItemsSource="{Binding Heroes}"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="120,0,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UnitTemplate}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Enemies (right of stage) -->
        <ItemsControl ItemsSource="{Binding Monsters}"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Margin="0,0,120,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource UnitTemplate}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

    <UserControl.Resources>
        <!-- Selection frame visibility + enemy tint -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Shared unit card: portrait placeholder, HP bar, stress pips, selection frame -->
        <DataTemplate x:Key="UnitTemplate">
            <Grid Width="170" Height="240" Margin="18,0">
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseEnter">
                        <i:ChangePropertyAction PropertyName="IsSelected" Value="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseLeave">
                        <i:ChangePropertyAction PropertyName="IsSelected" Value="False" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <!-- Unit body placeholder -->
                <Border Width="120" Height="160" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#5A4A3A" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                    <Setter Property="Background" Value="#6A2E24" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                </Border>

                <!-- Selection frame -->
                <Border BorderBrush="{x:Static ui:UiBrushes.Label}" BorderThickness="3" CornerRadius="10"
                        Width="138" Height="178" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0"
                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                <!-- Name -->
                <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="18"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,182,0,0" />

                <!-- Health bar -->
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpRatio, Mode=OneWay}"
                             Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="10,210,10,0" />

                <!-- Stress pips -->
                <ItemsControl ItemsSource="{Binding StressPips}" VerticalAlignment="Top" Margin="55,228,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Rectangle Width="8" Height="8" Margin="1,0" Fill="#4A5A6A" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
</UserControl>
