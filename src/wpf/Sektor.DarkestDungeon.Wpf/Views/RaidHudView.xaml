<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.RaidHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <UserControl.Resources>
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </UserControl.Resources>

    <Border Background="#E6000000" BorderBrush="#3A2E22" BorderThickness="0,2,0,0">
        <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="710" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="707" />
            </Grid.ColumnDefinitions>

            <!-- Left: hero banner + stats -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <views:HeroBannerView DataContext="{Binding Hero}" Height="136" />
                <views:HeroStatsView DataContext="{Binding Hero.Stats}" Height="204" />
            </StackPanel>

            <!-- Right: inventory / map (toggle) -->
            <Grid Grid.Column="2">
                <views:InventoryView DataContext="{Binding Inventory}"
                                     Visibility="{Binding IsInventoryShown, Converter={StaticResource BoolToVisibility}}" />
                <views:MapView DataContext="{Binding Map}"
                               Visibility="{Binding IsInventoryShown, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Content="MAP / INVENTORY"
                        Command="{Binding ToggleRightPanelCommand}"
                        HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                        Background="{x:Static ui:UiBrushes.ButtonBackground}"
                        Foreground="{x:Static ui:UiBrushes.Label}"
                        Padding="14,4" FontSize="16" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
