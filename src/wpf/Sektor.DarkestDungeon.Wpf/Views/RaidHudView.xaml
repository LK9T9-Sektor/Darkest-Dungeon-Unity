<UserControl x:Class="Sektor.DarkestDungeon.Wpf.Views.RaidHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Sektor.DarkestDungeon.Wpf.Views"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui">
    <Border Background="#E6000000" BorderBrush="#3A2E22" BorderThickness="0,2,0,0">
        <Grid Margin="0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="710" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="707" />
            </Grid.ColumnDefinitions>

            <!-- Left: framed hero info (banner + stats) -->
            <views:HeroInfoPanelView Grid.Column="0" DataContext="{Binding}"
                                     HorizontalAlignment="Center" VerticalAlignment="Top" Width="690" />

            <!-- Right: inventory / map, toggled by the buttons below -->
            <Grid Grid.Column="2">
                <views:InventoryView DataContext="{Binding Inventory}"
                                     Visibility="{Binding DataContext.IsInventoryShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource BoolToVisibility}}" />
                <views:MapView DataContext="{Binding Map}"
                               Visibility="{Binding DataContext.IsInventoryShown, RelativeSource={RelativeSource AncestorType={x:Type views:RaidHudView}}, Converter={StaticResource InverseBoolToVisibility}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,4,12,0">
                    <Button Content="INVENTORY" Command="{Binding ShowInventoryCommand}" Margin="0,0,8,0"
                            Background="{x:Static ui:UiBrushes.ButtonBackground}"
                            Foreground="{x:Static ui:UiBrushes.Label}" Padding="14,4" FontSize="16" />
                    <Button Content="MAP" Command="{Binding ShowMapCommand}"
                            Background="{x:Static ui:UiBrushes.ButtonBackground}"
                            Foreground="{x:Static ui:UiBrushes.Label}" Padding="14,4" FontSize="16" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
