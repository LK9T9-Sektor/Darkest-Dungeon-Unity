<Application x:Class="Sektor.DarkestDungeon.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ui="clr-namespace:Sektor.DarkestDungeon.Wpf.Ui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <ui:StringToVisibilityConverter x:Key="StringToVisibility" />

            <!-- Shared stage unit card: body, HP/stress bars, selection frame -->
            <DataTemplate x:Key="UnitTemplate">
                <Grid Width="200" Height="265" Margin="18,0">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseEnter">
                            <i:InvokeCommandAction Command="{Binding DataContext.HoverCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CommandParameter="{Binding}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding DataContext.UnhoverCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                        </i:EventTrigger>
                        <i:EventTrigger EventName="MouseRightButtonDown">
                            <i:InvokeCommandAction Command="{Binding DataContext.OpenStatsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                   CommandParameter="{Binding}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <!-- Unit body placeholder: same width as the HP/stress bars -->
                    <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="190" Margin="16,18,16,0"
                            CornerRadius="8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#5A4A3A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnemy}" Value="True">
                                        <Setter Property="Background" Value="#6A2E24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ClassName}" Foreground="#E8D9B0" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </Border>

                    <!-- Selection frame -->
                    <Border BorderBrush="{x:Static ui:UiBrushes.Label}" BorderThickness="3" CornerRadius="10"
                            HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="194" Margin="14,16,14,0"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Name -->
                    <TextBlock Text="{Binding Name}" Foreground="#E8D9B0" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,210,0,0" />

                    <!-- Health bar: fixed width, fill varies with HP -->
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding HpRatio, Mode=OneWay}"
                                 Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,236,16,0" />

                    <!-- Stress bar: same full width as the health bar, split into 10 squares -->
                    <ItemsControl ItemsSource="{Binding StressPips}" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Top" Margin="16,252,16,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Rectangle Height="9" Margin="1,0" Fill="#4A5A6A" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
