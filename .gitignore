# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!**/[Aa]ssets/**/*.meta

# Google Mobile Dependency Resolver: regenerated by Unity on import, unused by this project
**/Assets/MobileDependencyResolver/

# Uncomment this line if you wish to ignore the asset store tools plugin
**/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.unitypackage

# Game Assets
**/Assets/Audio/
**/Assets/Colours/
**/Assets/Sprites/
**/Assets/StreamingAssets/
**/Assets/Textures/
**/Assets/Video/
**/Assets/Resources/Data/Heroes/Sprites/
**/Assets/Resources/Dungeons/
**/Assets/Resources/Screen/
**/Assets/Resources/Sprites/

# Logs
UpgradeLog.htm
*.log

# Crashlytics generated file
crashlytics-build.properties

# ==============================================
# ДОПОЛНИТЕЛЬНЫЕ ПРАВИЛА ДЛЯ .NET ПРОЕКТОВ
# (Основано на шаблонах GitHub для Visual Studio и .NET)
# ==============================================

# --- Артефакты сборки .NET ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Ll]og/
[Ll]ogs/

# --- Файлы пакетов NuGet ---
*.nupkg
*.snupkg
# Root-anchored: the NuGet cache folder only (otherwise "packages/" also swallows Unity's "Packages/")
/packages/
.nuget/

# --- Файлы блокировки .NET Core ---
project.lock.json
project.fragment.lock.json

# --- Артефакты сборки ---
artifacts/
*.binlog
*.ilk
*.ilk.meta
*.obj
*.pch
*.idb
*.iobj
*.iobj.meta
*.ipdb
*.ipdb.meta
*.pgc
*.pgd

# --- Файлы для ASP.NET Scaffolding ---
ScaffoldingReadMe.txt

# --- Результаты тестов ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
CodeCoverage/

# --- Файлы IDE (кроме уже имеющихся) ---
.idea/          # JetBrains Rider
*.sln.iml       # Rider
*.rsuser        # Roslyn Analyzer
*.sln.docstates
*.csproj.user
*.csproj.bak

# --- Логи и временные файлы ---
*.tmp_proj
*_wpftmp.csproj
*.tlog
*.rsp
!Directory.Build.rsp
~$*
*~

# --- Другое ---
mono_crash.*
*.env
.tye/
BenchmarkDotNet.Artifacts/
StyleCopReport.xml
Generated\ Files/

# --- Исключения: реальные файлы проектов ядра (Unity-секция выше игнорирует *.csproj/*.sln) ---
!src/**/*.csproj
!tests/**/*.csproj
!*.slnx

# --- Доставленные пост-билдом бинарники ядра в слое презентации (артефакты сборки) ---
**/Assets/Plugins/Internal/

# --- Локальный dev AppID Steam (не коммитится) ---
steam_appid.txt

# Ignore for AI-agent
src/External/

# --- Unity user-specific settings (per-developer: layouts, prefs, search cache) ---
[Uu]serSettings/

# --- Unity Package Manager generated folders ---
UnityPackageManager/

# --- Unity package lock (regenerated by the editor) ---
**/Packages/packages-lock.json

# --- FMOD generated cache (regenerated on every import) ---
**/Assets/FMODStudioCache.asset
**/Assets/FMODStudioCache.asset.meta

# --- Editor-generated project settings noise (recreated on first editor open) ---
**/Packages/
**/ProjectSettings/PresetManager.asset
**/ProjectSettings/VersionControlSettings.asset
**/ProjectSettings/VFXManager.asset
**/ProjectSettings/MemorySettings.asset
**/ProjectSettings/MultiplayerManager.asset
**/ProjectSettings/PhysicsCoreProjectSettings2D.asset